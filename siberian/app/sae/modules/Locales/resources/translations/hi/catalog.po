msgid "Add a category"
msgstr "एक श्रेणी जोड़ें"

msgid "Add a format"
msgstr "एक प्रारूप जोड़ें"

msgid "Add a new product"
msgstr "एक नया उत्पाद जोड़ें"

msgid "All"
msgstr "सभी"

msgid "An error occurred while loading your product."
msgstr "आपके उत्पाद को लोड करते समय एक त्रुटि हुई।"

msgid "An error occurred while saving. One of your categories could not be identified."
msgstr "बचत करते समय एक त्रुटि हुई। आपकी श्रेणियों में से एक की पहचान नहीं की जा सकती है।"

msgid "An error occurred while saving. One of your products could not be identified."
msgstr "बचत करते समय एक त्रुटि हुई। आपके उत्पादों में से एक की पहचान नहीं की जा सकी।"

msgid "An error occurred while saving the category. Please try again later."
msgstr "श्रेणी को सहेजते समय एक त्रुटि हुई। कृपया बाद में पुन: प्रयास करें।"

msgid "An error occurred while saving the product. Please try again later."
msgstr "उत्पाद को सहेजते समय एक त्रुटि हुई। कृपया बाद में पुन: प्रयास करें।"

msgid "An error occurred while saving the set meal. Please try again later."
msgstr "सेट मील को सहेजते समय एक त्रुटि हुई। कृपया बाद में पुनः प्रयास करें।"

msgid "Are you sure you want to delete this category?"
msgstr "क्या आप वाकई इस श्रेणी को हटाना चाहते हैं?"

msgid "Are you sure you want to delete this category and all its subcategories?"
msgstr "क्या आप वाकई इस श्रेणी और उसके सभी उपश्रेणियों को हटाना चाहते हैं?"

msgid "Are you sure you want to delete this product?"
msgstr "क्या आप वाकई इस उत्पाद को हटाना चाहते हैं?"

msgid "Categories & Products"
msgstr "श्रेणियाँ और उत्पाद"

msgid "Category"
msgstr "श्रेणी"

msgid "Choose a category"
msgstr "एक श्रेणी चुनें"

msgid "Choose a subcategory"
msgstr "एक उपश्रेणी चुनें"

msgid "Click on a category to display sub-categories"
msgstr "उप-श्रेणियों को प्रदर्शित करने के लिए किसी श्रेणी पर क्लिक करें"

msgid "Create a new product"
msgstr "एक नया उत्पाद बनाएं"

msgid "Does this product have many formats?"
msgstr "क्या इस उत्पाद में कई प्रारूप हैं?"

msgid "Edit the"
msgstr "संपादित करें"

msgid "Edit the product"
msgstr "उत्पाद को संपादित करें"

msgid "Enable product formats?"
msgstr "उत्पाद प्रारूप सक्षम करें?"

msgid "Format"
msgstr "प्रारूप"

msgid "Manage Catalog & Products"
msgstr "कैटलॉग और उत्पाद प्रबंधित करें"

msgid "New category"
msgstr "नई श्रेणी"

msgid "New product"
msgstr "नया उत्पाद"

msgid "Picture"
msgstr "चित्र"

msgid "Price"
msgstr "कीमत"

msgid "Prices"
msgstr "कीमतें"

msgid "Product"
msgstr "उत्पाद"

msgid "Product formats"
msgstr "उत्पाद प्रारूप"

msgid "Product name"
msgstr "उत्पाद का नाम"

msgid "Rules"
msgstr "नियम"

msgid "Set meal successfully deleted."
msgstr "सेट भोजन सफलतापूर्वक हटाया गया।"

msgid "Set meal successfully saved."
msgstr "सेट भोजन सफलतापूर्वक सहेजा गया।"

msgid "Sub-category"
msgstr "उप-श्रेणी"

msgid "%s - All"
msgstr "%s - सभी"

