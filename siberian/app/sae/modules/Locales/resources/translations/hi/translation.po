msgid "Create a new language"
msgstr "एक नई भाषा बनाएँ"

msgid "Default text"
msgstr "डिफ़ॉल्ट पाठ"

msgid "Edit the language: %s"
msgstr "भाषा संपादित करें: %s"

msgid "Language"
msgstr "भाषा"

msgid "Language successfully saved"
msgstr "भाषा सफलतापूर्वक सहेजी गई"

msgid "List of your languages"
msgstr "अपनी भाषाओं की सूची"

msgid "Please, choose a file."
msgstr "कृपया, एक फाइल चुनें।"

msgid "Please, choose a language."
msgstr "कृपया, एक भाषा चुनें।"

msgid "Select a file"
msgstr "एक फ़ाइल का चयन करें"

msgid "Select a language"
msgstr "एक भाषा चुनें"

msgid "Text translation"
msgstr "पाठ में अनुवाद"

msgid "Translate all"
msgstr "सभी का अनुवाद करें"

msgid "Translate missing entries"
msgstr "लापता प्रविष्टियों का अनुवाद करें"

msgid "Translate the 'e.g.' between parentheses only."
msgstr "केवल कोष्ठक के बीच 'उदाहरण' का अनुवाद करें।"

msgid "Translation API is not available for the current language."
msgstr "अनुवाद API वर्तमान भाषा के लिए उपलब्ध नहीं है."

msgid "Warning: translation API is experimental for the current language and may fail."
msgstr "चेतावनी: अनुवाद एपीआई वर्तमान भाषा के लिए प्रयोगात्मक है और विफल हो सकता है।"

msgid "Your translation"
msgstr "आपका अनुवाद"

