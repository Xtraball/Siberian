# GMT 1793400000.0001
#. machine-translated (2026-10), to be reviewed
msgctxt "application"
msgid "Google Play App Signing"
msgstr "Google Play App Signing"

# GMT 1793400000.0002
#. machine-translated (2026-10), to be reviewed
msgctxt "application"
msgid "Enable it if your app uses Play App Signing: Google keeps the app signing key, and the keystore of this app is only the upload key you sign your bundles with."
msgstr "यदि आपका ऐप Play App Signing उपयोग करता है तो इसे सक्षम करें: Google ऐप साइनिंग की रखता है, और इस ऐप का keystore केवल वह अपलोड की है जिससे आप अपने बंडल पर हस्ताक्षर करते हैं।"

# GMT 1793400000.0003
#. machine-translated (2026-10), to be reviewed
msgctxt "application"
msgid "How Play App Signing works"
msgstr "Play App Signing कैसे काम करता है"

# GMT 1793400000.0004
#. machine-translated (2026-10), to be reviewed
msgctxt "application"
msgid "Google Play App Signing: the current keystore will be kept as a backup and a new upload key will be generated at the next build. Its certificate must be registered in the Play Console (upload key reset). Are you sure?"
msgstr "Google Play App Signing: वर्तमान keystore बैकअप के रूप में रखा जाएगा और अगले बिल्ड पर एक नई अपलोड की जनरेट होगी। इसका सर्टिफ़िकेट Play Console में पंजीकृत करना होगा (अपलोड की रीसेट)। क्या आप निश्चित हैं?"

# GMT 1793400000.0005
#. machine-translated (2026-10), to be reviewed
msgctxt "application"
msgid "Please confirm to save."
msgstr "सहेजने के लिए कृपया पुष्टि करें।"

# GMT 1793400000.0006
#. machine-translated (2026-10), to be reviewed
msgctxt "application"
msgid "The previous keystore was kept as %s"
msgstr "पिछला keystore %s के रूप में रखा गया था"

# GMT 1793400000.00065
#. machine-translated (2026-10), to be reviewed
msgctxt "application"
msgid "Its alias is %s, its store password %s and its key password %s."
msgstr "इसका alias %s है, इसका स्टोर पासवर्ड %s है और इसकी की पासवर्ड %s है।"

