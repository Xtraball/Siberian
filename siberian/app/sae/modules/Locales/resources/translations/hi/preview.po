msgid "Add"
msgstr "जोड़े"

msgid "An error occurred during the process. Please try again later."
msgstr "प्रक्रिया के दौरान एक त्रुटि हुई। कृपया बाद में पुन: प्रयास करें।"

msgid "An error occurred while deleting your preview. Please try again later."
msgstr "अपने पूर्वावलोकन को हटाने के दौरान एक त्रुटि हुई। कृपया बाद में पुन: प्रयास करें।"

msgid "An error occurred while saving your previews. Please try again later."
msgstr "आपके पूर्वावलोकन को सहेजते समय एक त्रुटि हुई। कृपया बाद में पुन: प्रयास करें।"

msgid "Click here to send your image"
msgstr "अपनी छवि भेजने के लिए यहां क्लिक करें"

msgid "Create a new preview"
msgstr "एक नया पूर्वावलोकन बनाएँ"

msgid "Delete image"
msgstr "छवि हटाएं"

msgid "Delete translation"
msgstr "अनुवाद हटाएँ"

msgid "Description"
msgstr "विवरण"

msgid "Drag and drop images to reorder them."
msgstr "खींचें और ड्रॉप छवियों उन्हें पुन: व्यवस्थित करने के लिए।"

msgid "Drop your image here"
msgstr "अपनी छवि को यहां छोड़ दें"

msgid "Edit the preview"
msgstr "पूर्वावलोकन संपादित करें"

msgid "Existing images :"
msgstr "मौजूदा छवियों:"

msgid "Feature"
msgstr "सुविधा"

msgid "Language"
msgstr "भाषा"

msgid "List of existing previews"
msgstr "मौजूदा पूर्वावलोकन की सूची"

msgid "OR"
msgstr "या"

msgid "Preview images"
msgstr "छवियों का पूर्वावलोकन करें"

msgid "Preview successfully saved"
msgstr "पूर्वावलोकन सफलतापूर्वक बचाया"

msgid "Previews"
msgstr "पूर्वावलोकन"

msgid "Search"
msgstr "खोज"

msgid "Sorry, but an existing preview for this feature has been found. Please edit existing one."
msgstr "क्षमा करें, लेकिन इस सुविधा के लिए एक मौजूदा पूर्वावलोकन पाया गया है। कृपया मौजूदा एक को संपादित करें।"

msgid "Title"
msgstr "शीर्षक"

msgid "Unable to copy the file."
msgstr "फ़ाइल की प्रतिलिपि बनाने में असमर्थ।"

msgid "Unable to create the directory."
msgstr "निर्देशिका बनाने में असमर्थ।"

msgid "Unable to delete the file."
msgstr "फ़ाइल को हटाने में असमर्थ।"

msgid "Unable to delete the file %s"
msgstr "फ़ाइल%s को हटाने में असमर्थ"

msgid "You don't have any previews yet"
msgstr "आपके पास अभी तक कोई पूर्वावलोकन नहीं है"

msgid "Your image has been successfully saved"
msgstr "आपकी छवि को सफलतापूर्वक सहेजा गया है"

msgid "Your preview has been deleted successfully."
msgstr "आपका पूर्वावलोकन सफलतापूर्वक हटा दिया गया है."

msgid "Your preview translation has been deleted successfully."
msgstr "आपका पूर्वावलोकन अनुवाद सफलतापूर्वक हटा दिया गया है."

msgid "<b>File types:</b> %s<br />"
msgstr "<b>फ़ाइल प्रकार:</b> %s<br />"

