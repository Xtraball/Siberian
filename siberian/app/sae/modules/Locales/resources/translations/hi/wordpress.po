msgid "1 day"
msgstr "1 दिन"

msgid "1 hour"
msgstr "1 घंटा"

msgid "1 minute"
msgstr "1 मिनट"

msgid "12 hours"
msgstr "12 घंटे"

msgid "15 minutes"
msgstr "15 मिनट"

msgid "3 hours"
msgstr "3 घंटे"

msgid "30 minutes"
msgstr "30 मिनट"

msgid "6 hours"
msgstr "6 घंटे"

msgid "Add a query"
msgstr "एक क्वेरी जोड़ें"

msgid "An error occurred while accessing your Wordpress website. Please, verify the domain name %s"
msgstr "आपकी WordPress वेबसाइट तक पहुँचते समय एक त्रुटि हुई। कृपया डोमेन नाम %s सत्यापित करें"

msgid "Ascending"
msgstr "आरोही"

msgid "Author"
msgstr "लेखक"

msgid "Cache lifetime (excluding pull to refresh)"
msgstr "कैश जीवनकाल (पुल-टू-रिफ़्रेश को छोड़कर)"

msgid "Categories successfully saved"
msgstr "श्रेणियाँ सफलतापूर्वक सहेजी गईं"

msgid "Click here to download our Wordpress plugin"
msgstr "हमारे WordPress प्लगइन डाउनलोड करने के लिए यहां क्लिक करें"

msgid "Cover & Thumbnails are only visible when queries are not grouped."
msgstr "कवर और थंबनेल केवल तभी दिखाई देते हैं जब क्वेरी समूहीकृत न हों।"

msgid "Date"
msgstr "तिथि"

msgid "Descending"
msgstr "अवरोही"

msgid "Enter your Wordpress URL:"
msgstr "अपना WordPress URL दर्ज करें:"

msgid "Group all queries into a single list"
msgstr "सभी क्वेरी को एक सूची में समूहित करें"

msgid "ID"
msgstr "आईडी"

msgid "If your WordPress is secured by a login/password, and/or you want to display private posts you can set here a user to be used to retrieve posts."
msgstr "यदि आपका WordPress लॉगिन/पासवर्ड से सुरक्षित है, और/या आप निजी पोस्ट दिखाना चाहते हैं, तो आप यहाँ पोस्ट प्राप्त करने के लिए उपयोग किया जाने वाला उपयोगकर्ता सेट कर सकते हैं।"

msgid "Loading categories"
msgstr "श्रेणियाँ लोड हो रही हैं"

msgid "Manage WordPress"
msgstr "वर्डप्रेस प्रबंधित करें"

msgid "Manage queries"
msgstr "क्वेरीज़ प्रबंधित करें"

msgid "No cache"
msgstr "कोई कैश नहीं"

msgid "Note: cache is automatically refreshed on any user pull to refresh action whatever the lifetime set."
msgstr "नोट: निर्धारित अवधि चाहे जो भी हो, उपयोगकर्ता द्वारा पुल-टू-रिफ़्रेश करने पर कैश अपने आप रीफ़्रेश हो जाता है।"

msgid "Pages"
msgstr "पृष्ठ"

msgid "Relevance"
msgstr "प्रासंगिकता"

msgid "Show title & subtitle"
msgstr "शीर्षक और उपशीर्षक दिखाएँ"

msgid "Sorry, we are unable to fetch any category or post from your WordPress."
msgstr "क्षमा करें, हम आपके WordPress से कोई श्रेणी या पोस्ट प्राप्त करने में असमर्थ हैं।"

msgid "Sort by"
msgstr "द्वारा क्रमबद्ध करें"

msgid "Sort order"
msgstr "क्रमबद्ध क्रम"

msgid "Strip shortcodes"
msgstr "शॉर्टकोड हटाएं"

msgid "Unable to find your WordPress or /wp-json/ endpoint."
msgstr "आपका WordPress या /wp-json/ एंडपॉइंट खोजने में असमर्थ।"

msgid "Unlimited (until any pull to refresh)"
msgstr "असीमित (अगले पुल-टू-रिफ़्रेश तक)"

msgid "We are sorry but no category has been detected on your Wordpress website."
msgstr "हमें खेद है, लेकिन आपकी WordPress वेबसाइट पर कोई श्रेणी नहीं मिली।"

msgid "We are sorry but our Wordpress plugin hasn't been detected on your website. Please be sure it is correctly installed and activated."
msgstr "हमें खेद है, लेकिन आपकी वेबसाइट पर हमारा WordPress प्लगइन नहीं मिला। कृपया सुनिश्चित करें कि यह सही ढंग से इंस्टॉल और सक्रिय है।"

msgid "WordPress URL"
msgstr "वर्डप्रेस यूआरएल"

msgid "Wordpress"
msgstr "वर्डप्रेस"

msgid "You can mix posts & pages in the queries if needed."
msgstr "यदि आवश्यक हो तो आप क्वेरी में पोस्ट और पृष्ठ मिला सकते हैं।"

msgid "You can mix posts & pages in the queries if needed, however it's not recommended and can lead to random sorting."
msgstr "यदि आवश्यक हो तो आप क्वेरी में पोस्ट और पृष्ठ मिला सकते हैं, हालांकि इसकी अनुशंसा नहीं की जाती है और इससे क्रम अनियमित हो सकता है।"

