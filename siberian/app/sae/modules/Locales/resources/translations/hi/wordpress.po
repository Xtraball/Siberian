msgid "1 day"
msgstr "1 दिन"

msgid "1 hour"
msgstr "1 घंटा"

msgid "1 minute"
msgstr "1 मिनट"

msgid "12 hours"
msgstr "12 घंटे"

msgid "15 minutes"
msgstr "15 मिनटों"

msgid "3 hours"
msgstr "3 घंटे"

msgid "30 minutes"
msgstr "30 मिनटों"

msgid "6 hours"
msgstr "6 घंटे"

msgid "Add a query"
msgstr "एक क्वेरी जोड़ें"

msgid "An error occurred while accessing your Wordpress website. Please, verify the domain name %s"
msgstr "अपने WordPress वेबसाइट तक पहुँचने के दौरान एक त्रुटि हुई। कृपया, डोमेन नाम%s सत्यापित करें"

msgid "Ascending"
msgstr "आरोही"

msgid "Author"
msgstr "लेखक"

msgid "Cache lifetime (excluding pull to refresh)"
msgstr "कैश जीवनकाल (ताज़ा करने के लिए पुल को छोड़कर)"

msgid "Categories successfully saved"
msgstr "श्रेणियाँ सफलतापूर्वक बचाया"

msgid "Click here to download our Wordpress plugin"
msgstr "हमारे WordPress प्लगइन डाउनलोड करने के लिए यहां क्लिक करें"

msgid "Cover & Thumbnails are only visible when queries are not grouped."
msgstr "कवर और थंबनेल केवल तभी दिखाई दे रहे हैं जब प्रश्नों को समूहीकृत नहीं किया जाता है।"

msgid "Date"
msgstr "तिथि"

msgid "Descending"
msgstr "उतरते"

msgid "Enter your Wordpress URL:"
msgstr "अपने WordPress यूआरएल दर्ज करें:"

msgid "Group all queries into a single list"
msgstr "सभी प्रश्नों को एक सूची में समूहित करें"

msgid "ID"
msgstr "आईडी"

msgid "If your WordPress is secured by a login/password, and/or you want to display private posts you can set here a user to be used to retrieve posts."
msgstr "अपने WordPress एक लॉगिन/पासवर्ड से सुरक्षित है, और/या आप निजी पदों आप यहाँ एक उपयोगकर्ता पदों को पुनः प्राप्त करने के लिए इस्तेमाल किया जा करने के लिए सेट कर सकते हैं प्रदर्शित करना चाहते हैं।"

msgid "Loading categories"
msgstr "श्रेणियों लोड हो रहा है"

msgid "Manage WordPress"
msgstr "वर्डप्रेस प्रबंधित करें"

msgid "Manage queries"
msgstr "क्वेरीज़ प्रबंधित करें"

msgid "No cache"
msgstr "कोई कैश नहीं"

msgid "Note: cache is automatically refreshed on any user pull to refresh action whatever the lifetime set."
msgstr "नोट: किसी भी उपयोगकर्ता पुल पर कैश स्वचालित रूप से रीफ्रेश हो जाता है ताकि आजीवन सेट की गई कार्रवाई को रीफ्रेश किया जा सके।"

msgid "Pages"
msgstr "पेज"

msgid "Relevance"
msgstr "प्रासंगिकता"

msgid "Show title & subtitle"
msgstr "शीर्षक और उपशीर्षक दिखाएँ"

msgid "Sorry, we are unable to fetch any category or post from your WordPress."
msgstr "क्षमा करें, हम अपने WordPress से किसी भी वर्ग या पोस्ट लाने में असमर्थ हैं।"

msgid "Sort by"
msgstr "द्वारा क्रमबद्ध करें"

msgid "Sort order"
msgstr "क्रमबद्ध क्रम"

msgid "Strip shortcodes"
msgstr "पट्टी शॉर्टकोड"

msgid "Unable to find your WordPress or /wp-json/ endpoint."
msgstr "अपने WordPress या/WP-JSON/समापन बिंदु को खोजने में असमर्थ।"

msgid "Unlimited (until any pull to refresh)"
msgstr "असीमित (ताज़ा करने के लिए किसी भी पुल तक)"

msgid "We are sorry but no category has been detected on your Wordpress website."
msgstr "हमें खेद है, लेकिन कोई श्रेणी अपने Wordpress वेबसाइट पर पाया गया है।"

msgid "We are sorry but our Wordpress plugin hasn't been detected on your website. Please be sure it is correctly installed and activated."
msgstr "हमें खेद है, लेकिन हमारे WordPress प्लगइन अपनी वेबसाइट पर पता नहीं किया गया है। कृपया सुनिश्चित करें कि यह सही ढंग से स्थापित और सक्रिय है।"

msgid "WordPress URL"
msgstr "वर्डप्रेस यूआरएल"

msgid "Wordpress"
msgstr "वर्डप्रेस"

msgid "You can mix posts & pages in the queries if needed."
msgstr "यदि आवश्यक हो तो आप प्रश्नों में पदों और पृष्ठों मिश्रण कर सकते हैं।"

msgid "You can mix posts & pages in the queries if needed, however it's not recommended and can lead to random sorting."
msgstr "यदि आवश्यक हो तो आप प्रश्नों में पोस्ट और पृष्ठों को मिश्रण कर सकते हैं, हालांकि इसकी अनुशंसा नहीं की जाती है और यादृच्छिक सॉर्टिंग का कारण बन सकती है।"

