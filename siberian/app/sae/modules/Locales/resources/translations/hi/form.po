msgid "<strong>%s</strong> is not a numerical value<br />"
msgstr "<strong>%s</strong> एक संख्यात्मक मान<br />नहीं है"

msgid "<strong>%s</strong> is not valid email address<br />"
msgstr "<strong>%s</strong> मान्य ईमेल पता<br />नहीं है"

msgid "<strong>%s</strong> is required<br />"
msgstr "<strong>%s</strong> की आवश्यकता<br />है"

msgid "<strong>%s</strong> must be a numerical value<br />"
msgstr "<strong>%s</strong> एक संख्यात्मक मान<br />होना चाहिए"

msgid "<strong>%s</strong> must be a valid date (e.g. dd/mm/yyyy)<br />"
msgstr "<strong>% s</strong> एक वैध तिथि होना चाहिए (उदाहरण के लिए डीडी/एमएम/yyyy)<br />"

msgid "<strong>%s</strong> must be a valid date<br />"
msgstr "<strong>%s</strong> एक मान्य तिथि<br />होना चाहिए"

msgid "<strong>%s</strong> must be a valid email address<br />"
msgstr "<strong>%s</strong> एक मान्य ईमेल पता<br />होना चाहिए"

msgid "<strong>%s</strong> must be filled<br />"
msgstr "<strong>%s</strong> भरा<br />होना चाहिए"

