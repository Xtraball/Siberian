msgid "Geolocation"
msgstr "जियोलोकेशन"

msgid "Hello,"
msgstr "हैलो,"

msgid "Import a picture"
msgstr "एक तस्वीर आयात करें"

msgid "Import from Library"
msgstr "लाइब्रेरी से आयात करें"

msgid "Manage fields"
msgstr "फ़ील्ड प्रबंधित करें"

msgid "Manage options:"
msgstr "विकल्प प्रबंधित करें:"

msgid "Multiline text"
msgstr "बहुरेखित पाठ"

msgid "Option"
msgstr "विकल्प"

msgid "Radio"
msgstr "रेडियो"

msgid "Recipient email"
