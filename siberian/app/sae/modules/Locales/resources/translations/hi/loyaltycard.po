msgid "1 loyalty point ="
msgstr "1 वफादारी बिंदु ="

msgid "1 point"
msgstr "1 बिंदु"

msgid "1 validated point ="
msgstr "1 मान्य बिंदु ="

msgid "An error occurred while retrieving QRCode. Please try again later"
msgstr "QRCode को पुनः प्राप्त करते समय एक त्रुटि हुई। कृपया बाद में पुन: प्रयास करें"

msgid "An error occurred while saving the password. Please try again later"
msgstr "पासवर्ड सहेजते समय एक त्रुटि हुई। कृपया बाद में पुन: प्रयास करें"

msgid "An error occurred while saving your loyalty card."
msgstr "आपके लॉयल्टी कार्ड को सहेजते समय एक त्रुटि हुई।"

msgid "An error occurred while saving your loyalty card. Please fill all fields in."
msgstr "आपके लॉयल्टी कार्ड को सहेजते समय एक त्रुटि हुई। कृपया सभी क्षेत्रों में भरें।"

msgid "An error occurred while validating point. Please try again later."
msgstr "बिंदु को मान्य करते समय एक त्रुटि हुई। कृपया बाद में पुन: प्रयास करें।"

msgid "An error occurred with your QRCode."
msgstr "आपके QRCode के साथ एक त्रुटि हुई।"

msgid "Card name"
msgstr "कार्ड का नाम"

msgid "Congratulations"
msgstr "बधाई हो"

msgid "Current card"
msgstr "वर्तमान कार्ड"

msgid "Delete this password?"
msgstr "इस पासवर्ड को हटाएँ?"

msgid "Employee's name:"
msgstr "कर्मचारी का नाम:"

msgid "Employee's password:"
msgstr "कर्मचारी का पासवर्ड:"

msgid "Enter password"
msgstr "पासवर्ड दर्ज करें"

msgid "Enter the password"
msgstr "पासवर्ड दर्ज करें"

msgid "My new loyalty card"
msgstr "मेरा नया लॉयल्टी कार्ड"

