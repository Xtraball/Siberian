msgid "Additionnal Information"
msgstr "अतिरिक्त जानकारी"

msgid "An error occurred while deleting the push. Please try again later."
msgstr "पुश को हटाने के दौरान एक त्रुटि हुई। कृपया बाद में पुन: प्रयास करें।"

msgid "And a radius (in Km):"
msgstr "और एक त्रिज्या (किमी में):"

msgid "Android"
msgstr "एंड्रॉइड"

msgid "Creation date"
msgstr "निर्माण तिथि"

msgid "Custom URL"
msgstr "कस्टम URL"

msgid "Enter a location:"
msgstr "एक स्थान दर्ज करें:"

msgid "GCM Key"
msgstr "जीसीएम कुंजी"

msgid "I want to send it"
msgstr "मैं इसे भेजना चाहता हूं"

msgid "Keys successfully saved"
msgstr "कुंजी सफलतापूर्वक सहेजी गई"

msgid "Message"
msgstr "संदेश"

msgid "No device found for this user"
msgstr "इस उपयोगकर्ता के लिए कोई डिवाइस नहीं मिला"

msgid "No items."
msgstr "कोई आइटम नहीं."

msgid "Open a feature or a custom URL"
msgstr "एक सुविधा या एक कस्टम URL खोलें"

msgid "Pending"
msgstr "लंबित"

msgid "Please enter an expiration date for your message:"
msgstr "कृपया अपने संदेश के लिए एक समाप्ति तिथि दर्ज करें:"

msgid "Project Number"
msgstr "परियोजना संख्या"

msgid "Push Notifications"
msgstr "सूचनाएं पुश करें"

msgid "Push Notifications Settings"
msgstr "सूचनाएं सेटिंग्स पुश करें"

msgid "Push successfully deleted."
msgstr "पुश सफलतापूर्वक हटा दिया।"

msgid "Radius"
msgstr "त्रिज्या"

msgid "Send to a specific location"
msgstr "किसी विशिष्ट स्थान पर भेजें"

msgid "Send to all applications"
msgstr "सभी अनुप्रयोगों को भेजें"

msgid "Send to all my users"
msgstr "मेरे सभी उपयोगकर्ताओं को भेजें"

msgid "Send to no specific locations"
msgstr "कोई विशिष्ट स्थान पर भेजें"

msgid "Send to specific topics"
msgstr "विशिष्ट विषयों को भेजें"

msgid "Send to specific users"
msgstr "विशिष्ट उपयोगकर्ताओं को भेजें"

msgid "Sending date"
msgstr "भेजा जा रहा है तिथि"

msgid "The duration limit must be higher than the sent date"
msgstr "अवधि सीमा भेजी गई तारीख से अधिक होनी चाहिए"

msgid "Topics"
msgstr "विषय"

msgid "Users"
msgstr "उपयोगकर्ता"

msgid "You must choose a topic before sending your message."
msgstr "अपना संदेश भेजने से पहले आपको एक विषय चुनना होगा."

msgid "You must choose at least one user before sending your message."
msgstr "आपको अपना संदेश भेजने से पहले कम से कम एक उपयोगकर्ता चुनना होगा."

msgid "Your app must be published to send a push notification."
msgstr "पुश अधिसूचना भेजने के लिए आपका ऐप प्रकाशित होना चाहिए।"

msgid "Your message has been saved successfully."
msgstr "आपका संदेश सफलतापूर्वक सहेजा गया है."

msgid "Your message has been saved successfully and will be sent at the entered date"
msgstr "आपका संदेश सफलतापूर्वक सहेजा गया है और दर्ज की गई तिथि पर भेजा जाएगा"

msgid "Your message has been saved successfully and will be sent in a few minutes"
msgstr "आपका संदेश सफलतापूर्वक सहेजा गया है और कुछ ही मिनटों में भेजा जाएगा"

msgid "and users entering the area"
msgstr "और क्षेत्र में प्रवेश करने वाले उपयोगकर्ता"

msgid "for a limited period"
msgstr "सीमित अवधि के लिए"

msgid "now"
msgstr "अभी"

msgid "on a specific date"
msgstr "एक विशिष्ट तिथि पर"

