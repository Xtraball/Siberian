msgid "Options"
msgstr "विकल्प"

# GMT 1559644702.0126
#. machine-translated (2026-10), to be reviewed
msgctxt "customer"
msgid "To continue we must validate your e-mail, we will send you an e-mail with an activation link!"
msgstr "जारी रखने के लिए हमें आपका ई-मेल सत्यापित करना होगा, हम आपको सक्रियण लिंक वाला ई-मेल भेजेंगे!"

# GMT 1559644702.0127
#. machine-translated (2026-10), to be reviewed
msgctxt "customer"
msgid "YES"
msgstr "हां"

# GMT 1559644702.0128
#. machine-translated (2026-10), to be reviewed
msgctxt "customer"
msgid "NO"
msgstr "नहीं"

# GMT 1559644702.0129
#. machine-translated (2026-10), to be reviewed
msgctxt "customer"
msgid "Email validation"
msgstr "ईमेल सत्यापन"

# GMT 1559644702.0130
#. machine-translated (2026-10), to be reviewed
msgctxt "customer"
msgid "Sending e-mail..."
msgstr "ई-मेल भेजा जा रहा है..."

# GMT 1559644702.0131
#. machine-translated (2026-10), to be reviewed
msgctxt "customer"
msgid "Waiting validation"
msgstr "सत्यापन की प्रतीक्षा"

# GMT 1559644702.0132
#. machine-translated (2026-10), to be reviewed
msgctxt "customer"
msgid "Please check your inbox and click on the link to confirm your address!"
msgstr "कृपया अपना इनबॉक्स देखें और अपने पते की पुष्टि के लिए लिंक पर क्लिक करें!"

# GMT 1559644702.0133
#. machine-translated (2026-10), to be reviewed
msgctxt "customer"
msgid "You must validate your email in order to register!"
msgstr "पंजीकरण करने के लिए आपको अपना ईमेल सत्यापित करना होगा!"

# GMT 1559644702.0134
#. machine-translated (2026-10), to be reviewed
msgctxt "customer"
msgid "Request timed out, please try again!"
msgstr "अनुरोध का समय समाप्त हो गया, कृपया फिर प्रयास करें!"

# GMT 1559644702.0135
#. machine-translated (2026-10), to be reviewed
msgctxt "customer"
msgid "%s - Confirm your e-mail"
msgstr "%s - अपने ई-मेल की पुष्टि करें"

# GMT 1559644702.0136
#. machine-translated (2026-10), to be reviewed
msgctxt "customer"
msgid "Your email is invalid!"
msgstr "आपका ईमेल अमान्य है!"

# GMT 1559644702.0137
#. machine-translated (2026-10), to be reviewed
msgctxt "customer"
msgid "Please check your inbox and validate your e-mail!"
msgstr "कृपया अपना इनबॉक्स देखें और अपना ई-मेल सत्यापित करें!"

# GMT 1559644702.0138
#. machine-translated (2026-10), to be reviewed
msgctxt "customer"
msgid "Invalid request!"
msgstr "अमान्य अनुरोध!"

# GMT 1559644702.0139
#. machine-translated (2026-10), to be reviewed
msgctxt "customer"
msgid "this window will be closed automatically, please check the application!"
msgstr "यह विंडो अपने आप बंद हो जाएगी, कृपया एप्लिकेशन देखें!"

# GMT 1559644702.0140
#. machine-translated (2026-10), to be reviewed
msgctxt "customer"
msgid "Success"
msgstr "सफलता"

# GMT 1559644702.0141
#. machine-translated (2026-10), to be reviewed
msgctxt "customer"
msgid "This validation is already processed!"
msgstr "यह सत्यापन पहले ही प्रोसेस हो चुका है!"

# GMT 1559644702.0142
#. machine-translated (2026-10), to be reviewed
msgctxt "customer"
msgid "Enable e-mail confirmation"
msgstr "ई-मेल पुष्टि सक्षम करें"

# GMT 1559644702.0143
#. machine-translated (2026-10), to be reviewed
msgctxt "customer"
msgid "You can follow the URL below to validate your email address!"
msgstr "आप अपना ईमेल पता सत्यापित करने के लिए नीचे दिए गए URL का अनुसरण कर सकते हैं!"

# GMT 1559644702.0144
#. machine-translated (2026-10), to be reviewed
msgctxt "customer"
msgid "You cancelled the e-mail verification!"
msgstr "आपने ई-मेल सत्यापन रद्द कर दिया!"

# GMT 1559644702.0145
#. machine-translated (2026-10), to be reviewed
msgctxt "customer"
msgid "Thank you!"
msgstr "धन्यवाद!"

# GMT 1559644702.0146
#. machine-translated (2026-10), to be reviewed
msgctxt "customer"
msgid "Register"
msgstr "पंजीकरण करें"

# GMT 1559644702.0147
#. machine-translated (2026-10), to be reviewed
msgctxt "customer"
msgid "Your mobile number is not valid!"
msgstr "आपका मोबाइल नंबर मान्य नहीं है!"
