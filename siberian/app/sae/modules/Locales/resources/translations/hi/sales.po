msgid "Activate VAT number check with VIES"
msgstr "VIPS के साथ VAT नंबर चेक सक्रिय करें"

msgid "Add a custom text to the footer of your invoices"
msgstr "अपने चालान के पाद लेख के लिए एक कस्टम पाठ जोड़ें"

msgid "Invoice options"
msgstr "चालान विकल्प"

msgid "Offline plans"
msgstr "ऑफ़लाइन योजनाएं"

msgid "Paid at:"
