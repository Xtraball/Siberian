msgid "Activate VAT number check with VIES"
msgstr "VIES के साथ VAT नंबर जाँच सक्रिय करें"

msgid "Add a custom text to the footer of your invoices"
msgstr "अपने चालान के पाद लेख के लिए एक कस्टम पाठ जोड़ें"

msgid "Invoice options"
msgstr "चालान विकल्प"

msgid "Offline plans"
msgstr "ऑफ़लाइन योजनाएं"

msgid "Paid at:"
msgstr "भुगतान की तिथि:"

msgid "Payment Method"
msgstr "भुगतान विधि"

msgid "Price Excl. Tax"
msgstr "मूल्य (कर रहित)"

msgid "Sales configuration"
msgstr "बिक्री विन्यास"

msgid "This message will be displayed as a waiting message when your users chose an offline payment method"
msgstr "यह संदेश तब प्रतीक्षा संदेश के रूप में प्रदर्शित किया जाएगा जब आपके उपयोगकर्ता कोई ऑफ़लाइन भुगतान विधि चुनेंगे"

msgid "This message will be displayed as an information message to describe which offline payment method you offer"
msgstr "यह संदेश आपके द्वारा प्रदान की जाने वाली ऑफ़लाइन भुगतान विधि का वर्णन करने के लिए एक जानकारी संदेश के रूप में प्रदर्शित किया जाएगा"

msgid "Total Excl. Tax"
msgstr "कुल (कर रहित)"

msgid "VAT check options"
msgstr "VAT चेक विकल्प"

