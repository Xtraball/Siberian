msgid "Add a page"
msgstr "एक पृष्ठ जोड़ें"

msgid "Add feature"
msgstr "सुविधा जोड़ें"

msgid "Allow line return in Title & Subtitles"
msgstr "शीर्षक और उपशीर्षक में लाइन वापसी की अनुमति दें"

msgid "By checking this, a search field will appear in your folder feature"
msgstr "इसे चेक करके, आपके फ़ोल्डर सुविधा में एक खोज फ़ील्ड दिखाई देगा"

msgid "Cancel"
msgstr "रद्द करें"

msgid "Click on"
msgstr "पर क्लिक करें"

msgid "Click on a feature to add it to the folder"
msgstr "फ़ोल्डर में जोड़ने के लिए एक सुविधा पर क्लिक करें"

msgid "Click on a page to add it to the folder"
msgstr "फ़ोल्डर में जोड़ने के लिए किसी पृष्ठ पर क्लिक करें"

msgid "Click on a page to add it to the folder <span id='folder_name' class='folder_name'>%s</span>"
msgstr "<span id='folder_name' class='folder_name'>इसे फ़ोल्डर%s में जोड़ने के लिए किसी पृष्ठ पर क्लिक करें</span>"

msgid "Close mobile display"
msgstr "मोबाइल प्रदर्शन बंद करें"

msgid "Delete this folder and all its subfolders?"
msgstr "इस फ़ोल्डर और उसके सभी सबफ़ोल्डर हटाएं?"

msgid "Edit folder"
msgstr "फ़ोल्डर संपादित करें"

msgid "Enable search in folders"
msgstr "फ़ोल्डर में खोज सक्षम करें"

msgid "Folder title is required"
msgstr "फ़ोल्डर शीर्षक आवश्यक है"

msgid "Folders"
msgstr "फ़ोल्डर"

msgid "Inherit global layout"
msgstr "वैश्विक लेआउट का उत्तराधिकारी"

msgid "Mobile display"
msgstr "मोबाइल प्रदर्शन"

msgid "New folder"
msgstr "नया फ़ोल्डर"

msgid "No results for your request."
msgstr "आपके अनुरोध के लिए कोई परिणाम नहीं."

msgid "Override layout"
msgstr "लेआउट ओवरराइड करें"

msgid "Search results"
msgstr "खोज परिणाम"

msgid "Show cover"
msgstr "कवर दिखाएँ"

msgid "Show search field"
msgstr "खोज क्षेत्र दिखाएँ"

msgid "Show title"
msgstr "शीर्षक दिखाएँ"

msgid "Thumbnail"
msgstr "थंबनेल"

msgid "Use card design"
msgstr "कार्ड डिजाइन का उपयोग करें"

msgid "You cannot add this feature"
msgstr "आप इस सुविधा को नहीं जोड़ सकते"

msgid "You must first complete the current category creation process"
msgstr "आपको पहले वर्तमान श्रेणी निर्माण प्रक्रिया को पूरा करना होगा"

msgid "You will lose all unsaved changes, continue?"
msgstr "आप सभी सहेजे गए परिवर्तन खो देंगे, जारी रखें?"

msgid "to add a folder."
msgstr "एक फ़ोल्डर जोड़ने के लिए।"

