msgid "1 day"
msgstr "1 día"

msgid "1 hour"
msgstr "1 hora"

msgid "1 minute"
msgstr "1 minuto"

msgid "12 hours"
msgstr "12 horas"

msgid "15 minutes"
msgstr "15 minutos"

msgid "3 hours"
msgstr "3 horas"

msgid "30 minutes"
msgstr "30 minutos"

msgid "6 hours"
msgstr "6 horas"

msgid "Add a query"
msgstr "Agregar una consulta"

msgid ""
"An error occurred while accessing your Wordpress website. Please, verify the "
"domain name %s"
msgstr ""
"Un error ha surgido al acceder a su Wordpress. Por favor compruebe el "
"dominio ingresado %s"

msgid "Ascending"
msgstr "Ascendente"

msgid "Author"
msgstr "Autor"

msgid "Cache lifetime (excluding pull to refresh)"
msgstr "Duración de la caché (excepto al tirar para actualizar)"

msgid "Categories successfully saved"
msgstr "Categorías guardadas correctamente."

msgid "Click here to download our Wordpress plugin"
msgstr "Haga clic aquí para descargar nuestro plugin de WordPress"

msgid "Cover & Thumbnails are only visible when queries are not grouped."
msgstr "La portada y las miniaturas solo son visibles cuando las consultas no están agrupadas."

msgid "Date"
msgstr "Fecha"

msgid "Descending"
msgstr "Descendente"

msgid "Enter your Wordpress URL:"
msgstr "Introduzca la URL de su WordPress:"

msgid "Group all queries into a single list"
msgstr "Agrupar todas las consultas en una sola lista"

msgid "ID"
msgstr "ID"

msgid ""
"If your WordPress is secured by a login/password, and/or you want to display "
"private posts you can set here a user to be used to retrieve posts."
msgstr "Si su WordPress está protegido con usuario/contraseña, o desea mostrar entradas privadas, puede establecer aquí un usuario para recuperar las entradas."

msgid "Loading categories"
msgstr "Cargando categorías"

msgid "Manage WordPress"
msgstr "Administrar WordPress"

msgid "Manage queries"
msgstr "Gestionar las consultas"

msgid "No cache"
msgstr "Sin caché"

msgid ""
"Note: cache is automatically refreshed on any user pull to refresh action "
"whatever the lifetime set."
msgstr "Nota: la caché se actualiza automáticamente en cada acción de tirar para actualizar del usuario, sea cual sea la duración establecida."

msgid "Pages"
msgstr "Páginas"

msgid "Relevance"
msgstr "Relevancia"

msgid "Show title & subtitle"
msgstr "Mostrar título y subtítulo"

msgid "Sorry, we are unable to fetch any category or post from your WordPress."
msgstr "Lo sentimos, no podemos recuperar ninguna categoría ni entrada de su WordPress."

msgid "Sort by"
msgstr "Ordenar por"

msgid "Sort order"
msgstr "Criterio de ordenación"

msgid "Strip shortcodes"
msgstr "Eliminar shortcodes"

msgid "Unable to find your WordPress or /wp-json/ endpoint."
msgstr "No se puede encontrar su WordPress ni el endpoint /wp-json/."

msgid "Unlimited (until any pull to refresh)"
msgstr "Ilimitado (hasta que tire para actualizar)"

msgid ""
"We are sorry but no category has been detected on your Wordpress website."
msgstr "Lo sentimos no hemos encontrado categorías en su sitio Wordpress."

msgid ""
"We are sorry but our Wordpress plugin hasn't been detected on your website. "
"Please be sure it is correctly installed and activated."
msgstr "Lo sentimos, no hemos detectado nuestro plugin en su sitio Wordpress. Por favor, asegúrese de que está correctamente instalado y activado."

msgid "WordPress URL"
msgstr "WordPress URL"

msgid "Wordpress"
msgstr "WordPress"

msgid "You can mix posts & pages in the queries if needed."
msgstr "Puede mezclar los posts y páginas en las consultas si es necesario."

msgid ""
"You can mix posts & pages in the queries if needed, however it's not "
"recommended and can lead to random sorting."
msgstr ""
"Usted puede mezclar los posts y páginas en las consultas si es necesario, "
"sin embargo no es recomendable y puede conducir a la clasificación aleatoria."
