msgid "<b>Actual preview version is Siberian 5.0</b>."
msgstr "<b>La versión de vista previa actual es Siberian 5.0</b>."

msgid ""
"<b>Disclaimer:</b> You are using the <b>preview</b> update channel, this "
"channel is intended for <b>tests & previews</b> of new features, if you are "
"not sure stay with <b>stable channel</b>."
msgstr "<b>Aviso:</b> Está usando el canal de actualizaciones <b>de vista previa</b>; este canal está orientado a <b>pruebas y previsualizaciones</b> de nuevas funciones. Si no está seguro, manténgase en el <b>canal estable</b>."

msgid ""
"<b>Note for Bug report:</b> give us a maximum of description of how you "
"reached the bug, and possibly screenshots."
msgstr "<b>Nota para el informe de errores:</b> explíquenos con el mayor detalle posible cómo llegó al error y, si es posible, envíe capturas de pantalla."

msgid ""
"<b>Note</b>: sources & push will be sent immediately after their creation, "
"scheduled push will not work & media optimization is disabled."
msgstr "<b>Nota</b>: el código fuente y los push se enviarán inmediatamente después de su creación, los push programados no funcionarán y la optimización de medios estará desactivada."

