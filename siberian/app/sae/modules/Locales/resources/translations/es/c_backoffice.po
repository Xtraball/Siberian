msgstr "Núcleo"

# GMT 1793100001.0002
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "App sources"
msgstr "Fuentes de la aplicación"

# GMT 1793100001.0003
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Modified"
msgstr "Modificado"

# GMT 1793100001.0004
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Missing"
msgstr "Ausente"

# GMT 1793100001.0005
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Unreadable"
msgstr "Ilegible"

# GMT 1793100001.0006
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "File"
msgstr "Archivo"

# GMT 1793100001.0007
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Status"
msgstr "Estado"

# GMT 1793100001.0008
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Area"
msgstr "Área"

# GMT 1793100001.0009
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Files checked"
msgstr "Archivos comprobados"

# GMT 1793100001.0010
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Core files only, skip the app sources (faster)"
msgstr "Solo archivos del núcleo, omitir las fuentes de la aplicación (más rápido)"

# GMT 1793100001.0011
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Module installations and generated apps also write in the app sources, differences there are not necessarily a problem."
msgstr "Las instalaciones de módulos y las aplicaciones generadas también escriben en las fuentes de la aplicación, por lo que las diferencias ahí no son necesariamente un problema."

# GMT 1793100001.0012
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The file manifest.json is missing, the integrity cannot be checked."
msgstr "Falta el archivo manifest.json, no se puede comprobar la integridad."

# GMT 1793100001.0013
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The file manifest.json is not valid, the integrity cannot be checked."
msgstr "El archivo manifest.json no es válido, no se puede comprobar la integridad."

# GMT 1793100001.0014
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Edit my account"
msgstr "Editar mi cuenta"

# GMT 1793100001.0015
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Show / hide"
msgstr "Mostrar / ocultar"

# GMT 1793100001.0030
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "This job has no command."
msgstr "Esta tarea no tiene comando."

# GMT 1793100001.0031
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The class %s does not exist, the module providing this job is probably disabled or removed."
msgstr "La clase %s no existe, probablemente el módulo que proporciona esta tarea está desactivado o eliminado."

# GMT 1793100001.0032
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The class %s can not be loaded: %s"
msgstr "La clase %s no se puede cargar: %s"

# GMT 1793100001.0033
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s does not exist."
msgstr "El método %s no existe."

# GMT 1793100001.0034
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s is not public."
msgstr "El método %s no es público."

# GMT 1793100001.0035
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s is abstract."
msgstr "El método %s es abstracto."

# GMT 1793100001.0036
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s requires %d arguments, a job is given %d."
msgstr "El método %s requiere %d argumentos, a la tarea se le pasan %d."

# GMT 1793100001.0037
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The class %s can not be instantiated, declare the method %s static."
msgstr "La clase %s no se puede instanciar, declare el método %s como estático."

# GMT 1793100001.0038
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s is not static and the constructor of %s requires arguments, declare the method static."
msgstr "El método %s no es estático y el constructor de %s requiere argumentos, declare el método como estático."

# GMT 1793100001.0039
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s is not static. PHP 8 can not call it statically, the scheduler runs it on a new instance instead; declare it static."
msgstr "El método %s no es estático. PHP 8 no puede llamarlo de forma estática, el planificador lo ejecuta en una nueva instancia; declárelo como estático."

# GMT 1793100001.0040
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "This job can run."
msgstr "Esta tarea puede ejecutarse."

# GMT 1793100001.0041
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Compatibility with PHP"
msgstr "Compatibilidad con PHP"

# GMT 1793100001.0042
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Every job is checked against the PHP version that runs the scheduler, without running it."
msgstr "Cada tarea se comprueba con la versión de PHP que ejecuta el planificador, sin ejecutarla."

# GMT 1793100001.0043
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "PHP version"
msgstr "Versión de PHP"

# GMT 1793100001.0044
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Active jobs checked"
msgstr "Tareas activas comprobadas"

# GMT 1793100001.0045
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "All the active jobs can be run by the scheduler."
msgstr "El planificador puede ejecutar todas las tareas activas."

# GMT 1793100001.0046
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "A job that can not run is skipped and reported, it never stops the other jobs."
msgstr "Una tarea que no puede ejecutarse se omite y se notifica, nunca detiene las demás tareas."

# GMT 1793100001.0047
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Job"
msgstr "Tarea"

# GMT 1793100001.0048
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Problem"
msgstr "Problema"

# GMT 1793100001.0049
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Last error"
msgstr "Último error"

# GMT 1793100001.0050
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Compatibility"
msgstr "Compatibilidad"

# GMT 1793100001.0051
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Some cron jobs can not run with this PHP version:"
msgstr "Algunas tareas cron no pueden ejecutarse con esta versión de PHP:"

# GMT 1793100001.0052
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "see the details"
msgstr "ver los detalles"

# GMT 1793100001.0060
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Modules in quarantine"
msgstr "Módulos en cuarentena"

# GMT 1793100001.0061
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "A module stopped the application with a fatal error, or is not compatible with this version of Siberian or PHP. It is disabled until it is rechecked, the rest of the application keeps working."
msgstr "Un módulo detuvo la aplicación con un error fatal, o no es compatible con esta versión de Siberian o de PHP. Está desactivado hasta que se vuelva a comprobar, el resto de la aplicación sigue funcionando."

# GMT 1793100001.0062
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Needs a newer Siberian"
msgstr "Requiere una versión más reciente de Siberian"

# GMT 1793100001.0063
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Failed the compatibility check"
msgstr "No superó la comprobación de compatibilidad"

# GMT 1793100001.0064
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Fatal error"
msgstr "Error fatal"

# GMT 1793100001.0065
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Updated since, recheck it to enable it again."
msgstr "Actualizado desde entonces, vuelva a comprobarlo para activarlo de nuevo."

# GMT 1793100001.0066
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Recheck"
msgstr "Volver a comprobar"

# GMT 1793100001.0067
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Re-enable"
msgstr "Volver a activar"

# GMT 1793100001.0068
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Enable this module anyway? If it breaks the application again it goes back to quarantine."
msgstr "¿Activar este módulo de todos modos? Si vuelve a romper la aplicación, volverá a la cuarentena."

# GMT 1793100001.0069
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Recheck all"
msgstr "Volver a comprobar todo"

# GMT 1793100001.0070
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Scan all modules"
msgstr "Analizar todos los módulos"

# GMT 1793100001.0071
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "PHP or Siberian changed since the last compatibility scan of your modules."
msgstr "PHP o Siberian han cambiado desde el último análisis de compatibilidad de sus módulos."

# GMT 1793100001.0072
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Quarantine"
msgstr "Cuarentena"

# GMT 1793100001.0073
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Recheck done, %s released."
msgstr "Nueva comprobación finalizada, %s liberados."

# GMT 1793100001.0074
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The module is enabled again."
msgstr "El módulo se ha vuelto a activar."

# GMT 1793100001.0075
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The scan started, it can take a few minutes, reload this page to see the result."
msgstr "El análisis ha comenzado, puede tardar unos minutos, recargue esta página para ver el resultado."

# GMT 1793100001.0076
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The scan could not be started, run \"php cli module:quarantine scan\" instead."
msgstr "No se pudo iniciar el análisis, ejecute en su lugar \"php cli module:quarantine scan\"."
