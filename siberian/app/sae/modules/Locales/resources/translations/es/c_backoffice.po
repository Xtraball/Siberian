msgctxt "backoffice"
msgid "Password should be at least %s characters in length and should include at least one upper case letter, one number, and one special character."
msgstr "La contraseña debe tener al menos %s caracteres e incluir al menos una letra mayúscula, un número y un carácter especial."

# GMT 1793000000.0001
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "This version is already installed"
msgstr "Esta versión ya está instalada"

# GMT 1793000000.0002
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Would you like to reinstall it? Files are copied again and the module schema and data are synchronized again."
msgstr "¿Desea reinstalarla? Los archivos se copian de nuevo y el esquema y los datos del módulo se sincronizan de nuevo."

# GMT 1793000000.0003
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Yes, reinstall"
msgstr "Sí, reinstalar"

# GMT 1793000000.0004
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "No, cancel"
msgstr "No, cancelar"

# GMT 1793100000.0001
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The license saved for this module is expired or no longer valid. If you received a new key, enter it here, or keep the current one."
msgstr "La licencia guardada para este módulo ha caducado o ya no es válida. Si ha recibido una nueva clave, introdúzcala aquí, o conserve la actual."

# GMT 1793100000.0002
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Keep the current key"
msgstr "Conservar la clave actual"

# GMT 1793100001.0001
