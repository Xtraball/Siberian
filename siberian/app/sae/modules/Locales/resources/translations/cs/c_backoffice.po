# GMT 1793000000.0001
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "This version is already installed"
msgstr "Tato verze je již nainstalována"

# GMT 1793000000.0002
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Would you like to reinstall it? Files are copied again and the module schema and data are synchronized again."
msgstr "Chcete ji nainstalovat znovu? Soubory se zkopírují znovu a schéma a data modulu se znovu synchronizují."

# GMT 1793000000.0003
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Yes, reinstall"
msgstr "Ano, přeinstalovat"

# GMT 1793000000.0004
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "No, cancel"
msgstr "Ne, zrušit"

# GMT 1793100000.0001
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The license saved for this module is expired or no longer valid. If you received a new key, enter it here, or keep the current one."
msgstr "Licence uložená pro tento modul vypršela nebo již není platná. Pokud jste obdrželi nový klíč, zadejte jej zde, nebo ponechte stávající."

# GMT 1793100000.0002
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Keep the current key"
msgstr "Ponechat stávající klíč"

