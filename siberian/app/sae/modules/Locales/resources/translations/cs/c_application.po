msgid "How Play App Signing works"
msgstr "Jak funguje Play App Signing"

# GMT 1793400000.0004
#. machine-translated (2026-10), to be reviewed
msgctxt "application"
msgid "Google Play App Signing: the current keystore will be kept as a backup and a new upload key will be generated at the next build. Its certificate must be registered in the Play Console (upload key reset). Are you sure?"
msgstr "Google Play App Signing: aktuální keystore bude uchován jako záloha a při dalším sestavení bude vygenerován nový nahrávací klíč. Jeho certifikát musí být zaregistrován v Play Console (reset nahrávacího klíče). Jste si jisti?"

# GMT 1793400000.0005
#. machine-translated (2026-10), to be reviewed
msgctxt "application"
msgid "Please confirm to save."
msgstr "Potvrďte prosím uložení."

# GMT 1793400000.0006
#. machine-translated (2026-10), to be reviewed
msgctxt "application"
msgid "The previous keystore was kept as %s"
msgstr "Předchozí keystore byl uchován jako %s"

# GMT 1793400000.00065
#. machine-translated (2026-10), to be reviewed
msgctxt "application"
msgid "Its alias is %s, its store password %s and its key password %s."
msgstr "Jeho alias je %s, heslo úložiště %s a heslo klíče %s."

# GMT 1793400000.0007
#. machine-translated (2026-10), to be reviewed
msgctxt "application"
msgid "Unknown application."
msgstr "Neznámá aplikace."

# GMT 1793400000.0008
#. machine-translated (2026-10), to be reviewed
msgctxt "application"
msgid "The keystore cannot be saved."
msgstr "Keystore nelze uložit."

# GMT 1793400000.0009
#. machine-translated (2026-10), to be reviewed
msgctxt "application"
msgid "The keystore has been replaced."
msgstr "Keystore byl nahrazen."

# GMT 1793400000.0010
#. machine-translated (2026-10), to be reviewed
msgctxt "application"
msgid "You are about to downgrade the version, after that you may not be able to update your Android application, please confirm if you are sure!"
msgstr "Chystáte se snížit verzi, poté již možná nebudete moci aktualizovat svou aplikaci pro Android, potvrďte prosím, že jste si jisti!"
