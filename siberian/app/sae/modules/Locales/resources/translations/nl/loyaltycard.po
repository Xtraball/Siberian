msgid "1 loyalty point ="
msgstr "1 loyaliteitspunt ="

msgid "1 point"
msgstr "1 punt"

msgid "1 validated point ="
msgstr "1 gecontroleerd punt ="

msgid "An error occurred while retrieving QRCode. Please try again later"
msgstr ""
"Er is een fout opgetreden bij het ophalen van QRCode. Probeer het later "
"opnieuw"

msgid "An error occurred while saving the password. Please try again later"
msgstr ""
"Er is een fout opgetreden tijdens het opslaan van het wachtwoord. Probeer "
"het later opnieuw"

msgid "An error occurred while saving your loyalty card."
msgstr "Er is een fout opgetreden tijdens het opslaan van uw klantenkaart."

msgid ""
"An error occurred while saving your loyalty card. Please fill all fields in."
msgstr ""
"Er is een fout opgetreden tijdens het opslaan van uw klantenkaart. Vul alle "
"velden in."

msgid "An error occurred while validating point. Please try again later."
msgstr "Er is een fout opgetreden bij het valideren van het punt. Probeer het later opnieuw."

msgid "An error occurred with your QRCode."
msgstr "Er is een fout opgetreden met je QRCode."

msgid "Card name"
msgstr "Kaartnaam"

msgid "Congratulations"
msgstr "Gefeliciteerd"

msgid "Current card"
msgstr "Huidige kaart"

msgid "Delete this password?"
msgstr "Verwijder dit wachtwoord?"

msgid "Employee's name:"
msgstr "Naam van werknemer:"

msgid "Employee's password:"
msgstr "Wachtwoord werknemer:"

msgid "Enter password"
msgstr "Voer het wachtwoord in"

msgid "Enter the password"
msgstr "Vul het wachtwoord in"

msgid "My new loyalty card"
msgstr "Mijn nieuwe klantenkaart"

msgid "My passwords"
msgstr "Mijn wachtwoorden"

msgid "No cards available"
msgstr "Geen kaarten beschikbaar"

msgid "Number of points"
msgstr "Aantal punten"

msgid "Please enter a name"
msgstr "Vul een naam in"

msgid "Please enter the password"
msgstr "Vul het wachtwoord in"

msgid ""
"Please show your phone to the store person so that he enters his password"
msgstr "Laat uw telefoon aan de medewerker van de winkel zien, zodat deze zijn wachtwoord kan invullen"

msgid "Point active"
msgstr "Punt actief"

msgid "Point inactive"
msgstr "Punt inactief"

msgid "Point%s successfully validated"
msgstr "Punten%s met succes gekeurd"

msgid "Previous cards"
msgstr "Vorige kaarten"

msgid "Reward"
msgstr "Beloning"

msgid "Rewards"
msgstr "Beloningen"

msgid "Scan QRCode"
msgstr "Scan QR-code"

msgid "This card is uniq:"
msgstr "Deze kaart is uniek:"

msgid "Unlock by QRCode"
msgstr "Ontgrendelen met QR-code"

msgid "Unreadable QRCode, sorry."
msgstr "Onleesbare QR-code, sorry."

msgid "Use only once?"
msgstr "Slechts één keer gebruiken?"

msgid "We are sorry but this card is temporarily blocked"
msgstr "Helaas is deze kaart tijdelijk geblokkeerd"

msgid ""
"Wrong password. Be carefull! %d remaining attempt%s before locking your "
"card. Ask the store person for validating your point"
msgstr ""
"Verkeerd wachtwoord. Wees voorzichtig!  %d nog %s resterende pogingen vóór "
"vergrendeling van uw kaart. Vraag aan het winkelpersoneel voor uw punt te "
"valideren"

msgid ""
"Wrong password.<br />Be careful !<br />%d remaining attempt%s before locking "
"your card.<br />Ask the store person for validating your point"
msgstr ""
"Verkeerd wachtwoord.<br/>Wees voorzichtig!<br/> %d nog %s resterende "
"pogingen vóór vergrendeling van uw kaart.<br/>Vraag het winkelpersoneel om "
"uw punt te valideren"

msgid ""
"You have exceeded the number of attempts to validate points. Your card is "
"locked for 24h"
msgstr ""
"U hebt het aantal pogingen om punten te valideren overschreden. Uw kaart is "
"geblokkeerd voor 24 uur"

msgid "You just finished your card"
msgstr "U hebt uw kaart vol"

msgid "You must be logged in to validate points"
msgstr "U moet ingelogd zijn om punten te valideren"

msgid "Your loyalty card has been saved successfully"
msgstr "Uw loyaliteitskaart is succesvol opgeslagen"

msgid "Your password must be 4 digits"
msgstr "Uw wachtwoord moet uit 4 cijfers bestaan"

msgid "is now yours!"
msgstr "is nu van u!"

msgid "point"
msgstr "punt"

msgid "point to validate"
msgstr "punt te valideren"

msgid "points to validate"
msgstr "punten te valideren"

msgid "validated points ="
msgstr "gevalideerde punten ="

