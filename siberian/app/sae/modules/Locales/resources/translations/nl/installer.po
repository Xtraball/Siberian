msgstr "Het bestand %s bestaat niet"

msgid "The file %s is not writable."
msgstr "Het bestand %s is niet beschrijfbaar."

msgid "The folder %s is not writable. Please fix this issue and try again."
msgstr ""
"De map %s  is niet beschrijfbaar. Verhelp dit probleem en probeer het "
"opnieuw."

msgid "The following files and folders are not writable:"
msgstr "De volgende bestanden en mappen zijn niet beschrijfbaar:"

