msgstr ""
"Sommige bestanden hebben niet de juiste rechten en kunnen niet worden "
"bijgewerkt"

msgid "Status"
msgstr "Status"

msgid "The database connection failed. Please, check the entered information."
msgstr "De databaseverbinding is mislukt. Controleer de ingevulde gegevens."

msgid "The entered password confirmation does not match the entered password."
msgstr "De ingevoerde wachtwoordbevestiging komt niet overeen met het ingevoerde wachtwoord."

