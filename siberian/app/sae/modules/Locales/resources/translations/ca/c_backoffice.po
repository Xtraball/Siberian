msgstr "La contrasenya ha de tenir com a mínim %s caràcters i ha d'incloure almenys una lletra majúscula, un número i un caràcter especial."

# GMT 1793000000.0001
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "This version is already installed"
msgstr "Aquesta versió ja està instal·lada"

# GMT 1793000000.0002
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Would you like to reinstall it? Files are copied again and the module schema and data are synchronized again."
msgstr "Voleu reinstal·lar-la? Els fitxers es tornen a copiar i l'esquema i les dades del mòdul es tornen a sincronitzar."

# GMT 1793000000.0003
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Yes, reinstall"
msgstr "Sí, reinstal·la"

# GMT 1793000000.0004
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "No, cancel"
msgstr "No, cancel·la"

# GMT 1793100000.0001
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The license saved for this module is expired or no longer valid. If you received a new key, enter it here, or keep the current one."
msgstr "La llicència desada per a aquest mòdul ha caducat o ja no és vàlida. Si heu rebut una clau nova, introduïu-la aquí o conserveu l'actual."

# GMT 1793100000.0002
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Keep the current key"
msgstr "Conserva la clau actual"

