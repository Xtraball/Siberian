msgid "Status"
msgstr "Estat"

# GMT 1793100001.0008
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Area"
msgstr "Àrea"

# GMT 1793100001.0009
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Files checked"
msgstr "Fitxers comprovats"

# GMT 1793100001.0010
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Core files only, skip the app sources (faster)"
msgstr "Només fitxers del nucli, omet els codis font de l'aplicació (més ràpid)"

# GMT 1793100001.0011
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Module installations and generated apps also write in the app sources, differences there are not necessarily a problem."
msgstr "Les instal·lacions de mòduls i les aplicacions generades també escriuen als codis font de l'aplicació; les diferències allà no són necessàriament un problema."

# GMT 1793100001.0012
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The file manifest.json is missing, the integrity cannot be checked."
msgstr "Falta el fitxer manifest.json, no es pot comprovar la integritat."

# GMT 1793100001.0013
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The file manifest.json is not valid, the integrity cannot be checked."
msgstr "El fitxer manifest.json no és vàlid, no es pot comprovar la integritat."

# GMT 1793100001.0014
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Edit my account"
msgstr "Edita el meu compte"

# GMT 1793100001.0015
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Show / hide"
msgstr "Mostra / amaga"

# GMT 1793100001.0030
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "This job has no command."
msgstr "Aquesta tasca no té cap ordre."

# GMT 1793100001.0031
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The class %s does not exist, the module providing this job is probably disabled or removed."
msgstr "La classe %s no existeix; probablement el mòdul que proporciona aquesta tasca està desactivat o eliminat."

# GMT 1793100001.0032
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The class %s can not be loaded: %s"
msgstr "La classe %s no es pot carregar: %s"

# GMT 1793100001.0033
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s does not exist."
msgstr "El mètode %s no existeix."

# GMT 1793100001.0034
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s is not public."
msgstr "El mètode %s no és públic."

# GMT 1793100001.0035
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s is abstract."
msgstr "El mètode %s és abstracte."

# GMT 1793100001.0036
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s requires %d arguments, a job is given %d."
msgstr "El mètode %s requereix %d arguments, a la tasca se'n donen %d."

# GMT 1793100001.0037
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The class %s can not be instantiated, declare the method %s static."
msgstr "La classe %s no es pot instanciar, declareu el mètode %s com a estàtic."

# GMT 1793100001.0038
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s is not static and the constructor of %s requires arguments, declare the method static."
msgstr "El mètode %s no és estàtic i el constructor de %s requereix arguments, declareu el mètode com a estàtic."

# GMT 1793100001.0039
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s is not static. PHP 8 can not call it statically, the scheduler runs it on a new instance instead; declare it static."
msgstr "El mètode %s no és estàtic. PHP 8 no el pot cridar estàticament, el planificador l'executa en una instància nova; declareu-lo com a estàtic."

# GMT 1793100001.0040
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "This job can run."
msgstr "Aquesta tasca es pot executar."

# GMT 1793100001.0041
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Compatibility with PHP"
msgstr "Compatibilitat amb PHP"

# GMT 1793100001.0042
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Every job is checked against the PHP version that runs the scheduler, without running it."
msgstr "Cada tasca es comprova amb la versió de PHP que executa el planificador, sense executar-la."

# GMT 1793100001.0043
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "PHP version"
msgstr "Versió de PHP"

# GMT 1793100001.0044
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Active jobs checked"
msgstr "Tasques actives comprovades"

# GMT 1793100001.0045
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "All the active jobs can be run by the scheduler."
msgstr "El planificador pot executar totes les tasques actives."

# GMT 1793100001.0046
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "A job that can not run is skipped and reported, it never stops the other jobs."
msgstr "Una tasca que no es pot executar s'omet i es notifica, i mai atura les altres tasques."

# GMT 1793100001.0047
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Job"
msgstr "Feina"

# GMT 1793100001.0048
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Problem"
msgstr "Problema"

# GMT 1793100001.0049
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Last error"
msgstr "Últim error"

# GMT 1793100001.0050
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Compatibility"
msgstr "Compatibilitat"

# GMT 1793100001.0051
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Some cron jobs can not run with this PHP version:"
msgstr "Algunes tasques cron no es poden executar amb aquesta versió de PHP:"

# GMT 1793100001.0052
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "see the details"
msgstr "vegeu els detalls"

# GMT 1793100001.0060
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Modules in quarantine"
msgstr "Mòduls en quarantena"

# GMT 1793100001.0061
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "A module stopped the application with a fatal error, or is not compatible with this version of Siberian or PHP. It is disabled until it is rechecked, the rest of the application keeps working."
msgstr "Un mòdul ha aturat l'aplicació amb un error fatal o no és compatible amb aquesta versió de Siberian o PHP. Està desactivat fins que es torni a comprovar; la resta de l'aplicació continua funcionant."

# GMT 1793100001.0062
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Needs a newer Siberian"
msgstr "Necessita un Siberian més recent"

# GMT 1793100001.0063
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Failed the compatibility check"
msgstr "No ha superat la comprovació de compatibilitat"

# GMT 1793100001.0064
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Fatal error"
msgstr "Error fatal"

# GMT 1793100001.0065
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Updated since, recheck it to enable it again."
msgstr "Actualitzat des d'aleshores, torneu-lo a comprovar per activar-lo de nou."

# GMT 1793100001.0066
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Recheck"
msgstr "Torna a comprovar"

# GMT 1793100001.0067
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Re-enable"
msgstr "Torna a activar"

# GMT 1793100001.0068
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Enable this module anyway? If it breaks the application again it goes back to quarantine."
msgstr "Voleu activar aquest mòdul igualment? Si torna a trencar l'aplicació, tornarà a quarantena."

# GMT 1793100001.0069
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Recheck all"
msgstr "Torna-ho a comprovar tot"

# GMT 1793100001.0070
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Scan all modules"
msgstr "Escaneja tots els mòduls"

# GMT 1793100001.0071
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "PHP or Siberian changed since the last compatibility scan of your modules."
msgstr "PHP o Siberian han canviat des de l'últim escaneig de compatibilitat dels mòduls."

# GMT 1793100001.0072
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Quarantine"
msgstr "Quarantena"

# GMT 1793100001.0073
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Recheck done, %s released."
msgstr "Comprovació feta, %s alliberats."

# GMT 1793100001.0074
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The module is enabled again."
msgstr "El mòdul torna a estar activat."

# GMT 1793100001.0075
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The scan started, it can take a few minutes, reload this page to see the result."
msgstr "L'escaneig ha començat, pot trigar uns minuts; torneu a carregar aquesta pàgina per veure'n el resultat."

# GMT 1793100001.0076
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The scan could not be started, run \"php cli module:quarantine scan\" instead."
msgstr "No s'ha pogut iniciar l'escaneig, executeu \"php cli module:quarantine scan\" en el seu lloc."
