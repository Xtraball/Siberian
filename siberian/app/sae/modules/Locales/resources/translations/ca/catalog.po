msgstr "Afegir un format"

msgid "Add a new product"
msgstr "Afegir un nou producte"

msgid "All"
msgstr "Tots"

msgid "An error occurred while loading your product."
msgstr "S'ha produït un error en carregar el producte."

msgid ""
"An error occurred while saving. One of your categories could not be "
"identified."
msgstr "S'ha produït un error en desar. No s'ha pogut identificar una de les categories."

msgid ""
"An error occurred while saving. One of your products could not be identified."
msgstr "S'ha produït un error en desar. No s'ha pogut identificar un dels productes."

msgid "An error occurred while saving the category. Please try again later."
msgstr ""
"S'ha produït un error en desar la categoria. Intenta-ho de nou més tard."

msgid "An error occurred while saving the product. Please try again later."
msgstr "S'ha produït un error en desar el producte. Intenta-ho de nou més tard."

msgid "An error occurred while saving the set meal. Please try again later."
msgstr "S'ha produït un error en desar el menú. Intenta-ho de nou més tard."

msgid "Are you sure you want to delete this category?"
msgstr "Esteu segur que voleu suprimir aquesta categoria?"

msgid ""
"Are you sure you want to delete this category and all its subcategories?"
msgstr ""
"Esteu segur que voleu suprimir aquesta categoria i totes les seves "
"subcategories?"

msgid "Are you sure you want to delete this product?"
msgstr "Segur que vols eliminar aquest producte?"

