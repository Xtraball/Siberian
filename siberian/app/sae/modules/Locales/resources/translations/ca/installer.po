msgid "The database connection failed. Please, check the entered information."
msgstr "La connexió a la base de dades ha fallat. Comproveu la informació introduïda."

msgid "The entered password confirmation does not match the entered password."
msgstr "La contrasenya vella no coincideix amb la contrasenya introduïda."

msgid "The file %s does not exist"
msgstr "El fitxer \"%s\" no existeix"

#. machine-translated (2026-10), to be reviewed
msgid "The file %s is not writable."
msgstr "El fitxer %s no és escrivible."

#. machine-translated (2026-10), to be reviewed
msgid "The folder %s is not writable. Please fix this issue and try again."
msgstr "La carpeta %s no és escrivible. Solucioneu el problema i torneu-ho a provar."

#. machine-translated (2026-10), to be reviewed
msgid "The following files and folders are not writable:"
msgstr "Els fitxers i carpetes següents no són escrivibles:"

#. machine-translated (2026-10), to be reviewed
msgid "The following files and folders are not writable: <br /> - %s"
msgstr "Els fitxers i carpetes següents no són escrivibles: <br /> - %s"

#. machine-translated (2026-10), to be reviewed
msgid "The package you have uploaded is invalid."
msgstr "El paquet que heu pujat no és vàlid."

#. machine-translated (2026-10), to be reviewed
msgid "There is no CMS license key set."
msgstr "No hi ha cap clau de llicència del CMS definida."

#. machine-translated (2026-10), to be reviewed
msgid "This process may take few minutes, please do not refresh the page"
msgstr "Aquest procés pot trigar uns minuts, no actualitzeu la pàgina"

#. machine-translated (2026-10), to be reviewed
msgid "This update is designed for the %s, you can't install it in your %s."
msgstr "Aquesta actualització està dissenyada per a %s, no la podeu instal·lar a %s."

#. machine-translated (2026-10), to be reviewed
msgid "Unable to check for updates now. Please, try again later."
msgstr "No es poden cercar actualitzacions ara. Torneu-ho a provar més tard."

#. machine-translated (2026-10), to be reviewed
msgid "Unable to connect to your FTP. Please check the connection information."
msgstr "No es pot connectar a l'FTP. Comproveu la informació de connexió."

#. machine-translated (2026-10), to be reviewed
msgid ""
"Unable to detect your site. Please make sure the entered path is correct."
msgstr "No es pot detectar el lloc. Assegureu-vos que el camp introduït és correcte."

#. machine-translated (2026-10), to be reviewed
msgid "Unable to extract the archive."
msgstr "No es pot extreure l'arxiu."

#. machine-translated (2026-10), to be reviewed
msgid "Unable to fetch the update. Please, try again later."
msgstr "No es pot obtenir l'actualització. Torneu-ho a provar més tard."

#. machine-translated (2026-10), to be reviewed
msgid "Unable to open the archive."
msgstr "No es pot obrir l'arxiu."

#. machine-translated (2026-10), to be reviewed
msgid ""
"Unable to open the file. Please, make sure that you sent a valid archive."
msgstr "No es pot obrir el fitxer. Assegureu-vos que heu enviat un arxiu vàlid."

#. machine-translated (2026-10), to be reviewed
msgid "Upload a module"
msgstr "Puja un mòdul"

#. machine-translated (2026-10), to be reviewed
msgid "Upload your modules"
msgstr "Pugeu els mòduls"

msgid "Username"
msgstr "Nom d'usuari"

msgid "Version"
msgstr "Versió"

