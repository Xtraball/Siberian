msgid "Additionnal Information"
msgstr "Informació addicional"

msgid "An error occurred while deleting the push. Please try again later."
msgstr "S'ha produït un error en suprimir la notificació push. Intenta-ho de nou més tard."

msgid "And a radius (in Km):"
msgstr "I un radi (en Km):"

msgid "Android"
msgstr "Android"

msgid "Creation date"
msgstr "Data de creació"

#. machine-translated (2026-10), to be reviewed
msgid "Custom URL"
msgstr "URL personalitzada"

msgid "Enter a location:"
msgstr "Introduïu una ubicació:"

msgid "GCM Key"
msgstr "Clau GCM"

msgid "I want to send it"
msgstr "Vull enviar-lo"

msgid "Keys successfully saved"
msgstr "Claus desades correctament"

msgid "Message"
msgstr "Missatge"

#. machine-translated (2026-10), to be reviewed
msgid "No device found for this user"
msgstr "No s'ha trobat cap dispositiu per a aquest usuari"

#. machine-translated (2026-10), to be reviewed
msgid "No items."
msgstr "Cap element."

#. machine-translated (2026-10), to be reviewed
msgid "Open a feature or a custom URL"
msgstr "Obre una funcionalitat o una URL personalitzada"

msgid "Pending"
msgstr "Pendent"

#. machine-translated (2026-10), to be reviewed
msgid "Please enter an expiration date for your message:"
msgstr "Introduïu una data de caducitat per al missatge:"

#. machine-translated (2026-10), to be reviewed
msgid "Project Number"
msgstr "Número de projecte"

msgid "Push Notifications"
msgstr "Notificacions push"

msgid "Push Notifications Settings"
msgstr "Configuració de les notificacions push"

msgid "Push successfully deleted."
msgstr "Notificació push eliminada correctament."

msgid "Radius"
msgstr "Radi"

msgid "Send to a specific location"
msgstr "Enviar a una ubicació específica"

#. machine-translated (2026-10), to be reviewed
msgid "Send to all applications"
msgstr "Envia a totes les aplicacions"

msgid "Send to all my users"
msgstr "Enviar a tots els meus usuaris"

msgid "Send to no specific locations"
msgstr "Enviar a cap ubicació específica"

msgid "Send to specific topics"
msgstr "Enviar a temes específics"

#. machine-translated (2026-10), to be reviewed
msgid "Send to specific users"
msgstr "Envia a usuaris específics"

msgid "Sending date"
msgstr "Data d'enviament"

msgid "The duration limit must be higher than the sent date"
msgstr "El límit de durada ha de ser posterior a la data d'enviament"

#. machine-translated (2026-10), to be reviewed
msgid "Topics"
msgstr "Temes"

msgid "Users"
msgstr "Usuaris"

#. machine-translated (2026-10), to be reviewed
msgid "You must choose a topic before sending your message."
msgstr "Heu de triar un tema abans d'enviar el missatge."

#. machine-translated (2026-10), to be reviewed
msgid "You must choose at least one user before sending your message."
msgstr "Heu de triar almenys un usuari abans d'enviar el missatge."

msgid "Your app must be published to send a push notification."
msgstr "L'aplicació s'ha de publicar per enviar una notificació push."

msgid "Your message has been saved successfully."
msgstr "El vostre missatge s'ha desat correctament."

msgid ""
"Your message has been saved successfully and will be sent at the entered date"
msgstr ""
"El seu missatge s'ha desat correctament i s'enviarà a la data introduïda"

msgid ""
"Your message has been saved successfully and will be sent in a few minutes"
msgstr "El seu missatge s'ha desat correctament i s'enviarà en pocs minuts"

msgid "and users entering the area"
msgstr "i usuaris que entren a la zona"

msgid "for a limited period"
msgstr "durant un període limitat"

msgid "now"
msgstr "ara"

msgid "on a specific date"
msgstr "en una data concreta"

