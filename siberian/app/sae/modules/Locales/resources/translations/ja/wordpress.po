msgid "1 day"
msgstr "1日"

msgid "1 hour"
msgstr "1時間"

msgid "1 minute"
msgstr "1分"

msgid "12 hours"
msgstr "12時間"

msgid "15 minutes"
msgstr "15分間"

msgid "3 hours"
msgstr "3時間"

msgid "30 minutes"
msgstr "30分"

msgid "6 hours"
msgstr "6時間"

msgid "Add a query"
msgstr "クエリの追加"

msgid "An error occurred while accessing your Wordpress website. Please, verify the domain name %s"
msgstr "Wordpress のウェブサイトにアクセス中にエラーが発生しました。 ドメイン名%s を確認してください"

msgid "Ascending"
msgstr "昇順"

msgid "Author"
msgstr "著者"

msgid "Cache lifetime (excluding pull to refresh)"
msgstr "キャッシュの有効期間（プルして更新する場合を除く）"

msgid "Categories successfully saved"
msgstr "カテゴリが正常に保存されました"

msgid "Click here to download our Wordpress plugin"
msgstr "私たちのWordpressのプラグインをダウンロードするにはここをクリックしてください"

msgid "Cover & Thumbnails are only visible when queries are not grouped."
msgstr "表紙とサムネイルは、クエリがグループ化されていない場合にのみ表示されます。"

msgid "Date"
msgstr "日付"

msgid "Descending"
msgstr "降順"

msgid "Enter your Wordpress URL:"
msgstr "Wordpress の URL を入力してください:"

msgid "Group all queries into a single list"
msgstr "すべてのクエリを 1 つのリストにまとめる"

msgid "ID"
msgstr "ID"

msgid "If your WordPress is secured by a login/password, and/or you want to display private posts you can set here a user to be used to retrieve posts."
msgstr "WordPress がログイン/パスワードで保護されている場合、または非公開の投稿を表示したい場合は、ここで投稿の取得に使用するユーザーを設定できます。"

msgid "Loading categories"
msgstr "カテゴリをロード中"

msgid "Manage WordPress"
msgstr "WordPress の管理"

msgid "Manage queries"
msgstr "クエリの管理"

msgid "No cache"
msgstr "キャッシュなし"

msgid "Note: cache is automatically refreshed on any user pull to refresh action whatever the lifetime set."
msgstr "注：設定された有効期間に関係なく、ユーザーがプルして更新するたびにキャッシュは自動的に更新されます。"

msgid "Pages"
msgstr "ページ"

msgid "Relevance"
msgstr "関連性"

msgid "Show title & subtitle"
msgstr "タイトルとサブタイトルを表示"

msgid "Sorry, we are unable to fetch any category or post from your WordPress."
msgstr "申し訳ありませんが、WordPressからカテゴリや投稿を取得することができません。"

msgid "Sort by"
msgstr "並び替え"

msgid "Sort order"
msgstr "並べ替え順序"

msgid "Strip shortcodes"
msgstr "ショートコードを除去"

msgid "Unable to find your WordPress or /wp-json/ endpoint."
msgstr "WordPress または /wp-json/ エンドポイントが見つかりません。"

msgid "Unlimited (until any pull to refresh)"
msgstr "無制限（プルして更新するまで）"

msgid "We are sorry but no category has been detected on your Wordpress website."
msgstr "申し訳ありませんが、あなたのWordpressのウェブサイトでカテゴリが検出されませんでした。"

msgid "We are sorry but our Wordpress plugin hasn't been detected on your website. Please be sure it is correctly installed and activated."
msgstr "申し訳ありませんが、私たちのWordpressのプラグインは、あなたのウェブサイト上で検出されていません。 正しくインストールされ、アクティベートされていることを確認してください。"

msgid "WordPress URL"
msgstr "WordPress URL"

msgid "Wordpress"
msgstr "WordPress"

msgid "You can mix posts & pages in the queries if needed."
msgstr "必要に応じて、クエリで投稿＆ページを混在させることができます。"

msgid "You can mix posts & pages in the queries if needed, however it's not recommended and can lead to random sorting."
msgstr "必要に応じて、クエリの投稿とページを混在させることができますが、それはお勧めしませんし、ランダムなソートにつながる可能性があります。"

