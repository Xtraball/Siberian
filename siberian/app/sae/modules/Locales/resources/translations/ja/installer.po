msgstr "インストールするモジュールがありません"

msgid "No modules uploaded yet"
msgstr "モジュールはまだアップロードされていません"

msgid "Or set the correct permissions to the following files and folders and try again:"
msgstr "または、次のファイルとフォルダーに正しいアクセス許可を設定し、もう一度試してください。"

msgid "Package"
msgstr "パッケージ"

msgid "Package Details"
msgstr "パッケージ詳細"

msgid "Path to your system"
msgstr "システムへのパス"

msgid "Please, enter a name"
msgstr "名前を入力してください"

msgid "Please, fill out all fields"
msgstr "すべてのフィールドに記入してください"

msgid "Please update the module to the %s version before installing this update."
msgstr "この更新プログラムをインストールする前に、モジュールを%s バージョンに更新してください。"

msgid "Please update your system to the %s version before installing this update."
msgstr "この更新プログラムをインストールする前に、システムを%s バージョンに更新してください。"

msgid "Please wait, we're installing your module"
msgstr "お待ちください。モジュールをインストールしています"

msgid "Port"
msgstr "港"

msgid "Processing the installation"
msgstr "インストールの処理"

msgid "Progress"
msgstr "進捗"

msgid "Retry"
msgstr "リトライ"

