msgstr "フィーチャをクリックしてフォルダに追加します"

msgid "Click on a page to add it to the folder"
msgstr "ページをクリックしてフォルダに追加します"

msgid "Click on a page to add it to the folder <span id='folder_name' class='folder_name'>%s</span>"
msgstr "<span id='folder_name' class='folder_name'>ページをクリックして、フォルダ%s に追加します。</span>"

msgid "Close mobile display"
msgstr "モバイルディスプレイを閉じる"

msgid "Delete this folder and all its subfolders?"
msgstr "このフォルダとそのすべてのサブフォルダを削除しますか?"

msgid "Edit folder"
msgstr "フォルダの編集"

msgid "Enable search in folders"
msgstr "フォルダ内の検索を有効にする"

msgid "Folder title is required"
msgstr "フォルダタイトルが必要です"

msgid "Folders"
msgstr "フォルダ"

