msgid "Action"
msgstr "Действие"

msgid "Actions"
msgstr "Действия"

msgid "All of your modules are up to date"
msgstr "Все ваши модули находятся в актуальном состоянии"

msgid "An update is available. Click here to download it."
msgstr "Доступно обновление. Нажмите здесь, чтобы загрузить его."

msgid "Check for updates"
msgstr "Проверить наличие обновлений"

msgid "Click here to see the release notes"
msgstr "Нажмите здесь, чтобы просмотреть заметки о выпуске"

msgid "Click here to send your module"
msgstr "Нажмите здесь, чтобы отправить Ваш модуль"

msgid "Details"
msgstr "Подробности"

msgid "Drop your module here"
msgstr "Перетащите сюда ваш модуль"

msgid "Host"
msgstr "Хост"

msgid "Install"
msgstr "Установить"

msgid "Installing"
msgstr "Установка"

msgid "Installing your module"
msgstr "Установка вашего модуля"

msgid "Module successfully installed"
msgstr "Модуль успешно установлен"

msgid "Module to upload"
msgstr "Модуль для загрузки"

msgid "Modules Installation"
msgstr "Установка дополнительных модулей"

msgid "Modules successfully installed!"
msgstr "Модули успешно установлены!"

msgid "Name"
msgstr "Имя"

msgid "No directory provided"
msgstr "Каталог не указан"

msgid "No module to install"
msgstr "Нет модуля для установки"

msgid "No modules uploaded yet"
msgstr "Модули ещё не загружены"

msgid ""
"Or set the correct permissions to the following files and folders and try "
"again:"
msgstr ""
"Или установите правильные разрешения на следующие файлы и папки и попробуйте "
"снова:"

msgid "Package"
msgstr "Пакет"

msgid "Package Details"
msgstr "Подробности пакета"

msgid "Path to your system"
msgstr "Путь к вашей системе"

msgid "Please, enter a name"
msgstr "Пожалуйста, введите имя"

msgid "Please, fill out all fields"
msgstr "Пожалуйста, заполните все поля"

msgid ""
"Please update the module to the %s version before installing this update."
msgstr "Пожалуйста, обновите модуль до версии %s перед установкой этого обновления."

msgid ""
"Please update your system to the %s version before installing this update."
msgstr "Пожалуйста, обновите систему до версии %s перед установкой этого обновления."

msgid "Please wait, we're installing your module"
msgstr "Пожалуйста, подождите, мы устанавливаем модуль"

msgid "Port"
msgstr "Порт"

msgid "Processing the installation"
msgstr "Обработка установки"

msgid "Progress"
msgstr "Прогресс"

msgid "Retry"
msgstr "Повторить"

msgid "Select a module to upload"
msgstr "Выберите модуль для загрузки"

msgid "Size"
msgstr "Размер"

msgid ""
"Some files and folder are not writable. You can either provide your FTP "
"access to install this update:"
msgstr "Некоторые файлы и папки недоступны для записи. Вы можете предоставить FTP-доступ для установки этого обновления:"

msgid "Some files don't have the right permissions and can't be updated"
msgstr "Некоторые файлы не имеют нужных прав доступа и не могут быть обновлены"

msgid "Status"
msgstr "Статус"

msgid "The database connection failed. Please, check the entered information."
msgstr ""
"Подключение к базе данных не удалось. Пожалуйста, проверьте введенную "
"информацию."

msgid "The entered password confirmation does not match the entered password."
msgstr "Введённое подтверждение пароля не совпадает с введённым паролем."

msgid "The file %s does not exist"
msgstr "Файл %s не существует"

msgid "The file %s is not writable."
msgstr "Файл %s не доступен для записи."

msgid "The folder %s is not writable. Please fix this issue and try again."
msgstr "Папка %s не доступна для записи. Пожалуйста, устраните проблему и попробуйте ещё раз."

msgid "The following files and folders are not writable:"
msgstr "Следующие файлы и папки не доступны для записи:"

msgid "The following files and folders are not writable: <br /> - %s"
msgstr "Следующие файлы и папки не доступны для записи: <br /> - %s"

msgid "The package you have uploaded is invalid."
msgstr "Загруженный вами пакет недопустим."

msgid "There is no CMS license key set."
msgstr "Не задан лицензионный ключ CMS."

msgid "This process may take few minutes, please do not refresh the page"
msgstr ""
"Этот процесс может занять несколько минут, пожалуйста, не обновляйте страницу"

msgid "This update is designed for the %s, you can't install it in your %s."
msgstr ""
"Это обновление предназначено для %s, вы не можете установить его в вашем %s."

msgid "Unable to check for updates now. Please, try again later."
msgstr ""
"Не удалось проверить наличие обновлений. Пожалуйста, повторите попытку позже."

msgid "Unable to connect to your FTP. Please check the connection information."
msgstr ""
"Не удается подключиться к вашему FTP. Пожалуйста, проверьте информацию о "
"соединении."

msgid ""
"Unable to detect your site. Please make sure the entered path is correct."
msgstr ""
"Невозможно определить ваш сайт. Пожалуйста, убедитесь, что ввели правильный "
"путь."

msgid "Unable to extract the archive."
msgstr "Невозможно извлечь архив."

msgid "Unable to fetch the update. Please, try again later."
msgstr "Невозможно получить обновление. Пожалуйста, повторите попытку позже."

msgid "Unable to open the archive."
msgstr "Не удается открыть архив."

msgid ""
"Unable to open the file. Please, make sure that you sent a valid archive."
msgstr ""
"Не удается открыть файл. Пожалуйста, убедитесь, что вы отправили правильный "
"архив."

msgid "Upload a module"
msgstr "Загрузить модуль"

msgid "Upload your modules"
msgstr "Загрузите ваши модули"

msgid "Username"
msgstr "Имя пользователя"

msgid "Version"
msgstr "Версия "

msgid "We are checking for updates. Please, do not refresh the page."
msgstr "Мы проверяем  обновления. Пожалуйста, не обновляйте страницу."

msgid "You already have installed this template."
msgstr "Вы уже установили этот шаблон."

msgid "You already have installed this update."
msgstr "Вы уже установили это обновление."

msgid "Your system is up to date."
msgstr "Ваша система находится в актуальном состоянии."

msgid "%s Update"
msgstr "%s Обновление"
