msgid "Add"
msgstr "Добавить"

msgid "An error occurred during the process. Please try again later."
msgstr ""
"Произошла ошибка во время процесса. Пожалуйста, повторите попытку позже."

msgid "An error occurred while deleting your preview. Please try again later."
msgstr "Произошла ошибка при удалении вашего предпросмотра. Пожалуйста, повторите попытку позже."

msgid "An error occurred while saving your previews. Please try again later."
msgstr "Произошла ошибка при сохранении ваших предпросмотров. Пожалуйста, повторите попытку позже."

msgid "Click here to send your image"
msgstr "Нажмите здесь, чтобы загрузить ваше изображение"

msgid "Create a new preview"
msgstr "Создать новый предпросмотр"

msgid "Delete image"
msgstr "Удалить изображение"

msgid "Delete translation"
msgstr "Удалить перевод"

msgid "Description"
msgstr "Описание"

msgid "Drag and drop images to reorder them."
msgstr "Перетащите изображения, чтобы изменить их порядок."

msgid "Drop your image here"
msgstr "Перетащите сюда ваше изображение"

msgid "Edit the preview"
msgstr "Редактирование предпросмотра"

msgid "Existing images :"
msgstr "Существующие изображения :"

msgid "Feature"
msgstr "Функция"

msgid "Language"
msgstr "Язык"

msgid "List of existing previews"
msgstr "Список существующих превью"

msgid "OR"
msgstr "ИЛИ"

msgid "Preview images"
msgstr "Предварительный просмотр изображений"

msgid "Preview successfully saved"
msgstr "Предпросмотр успешно сохранён"

msgid "Previews"
msgstr "Предварительный просмотр"

msgid "Search"
msgstr "Поиск"

msgid ""
"Sorry, but an existing preview for this feature has been found. Please edit "
"existing one."
msgstr "Извините, но для этой функции уже найден существующий предпросмотр. Пожалуйста, отредактируйте его."

msgid "Title"
msgstr "Название"

msgid "Unable to copy the file."
msgstr "Не удаётся скопировать файл."

msgid "Unable to create the directory."
msgstr "Не удается создать каталог."

msgid "Unable to delete the file."
msgstr "Не удается удалить файл."

msgid "Unable to delete the file %s"
msgstr "Не удается удалить файл %s"

msgid "You don't have any previews yet"
msgstr "У вас пока нет предпросмотров"

msgid "Your image has been successfully saved"
msgstr "Изображение успешно сохранено"

msgid "Your preview has been deleted successfully."
msgstr "Ваш предпросмотр успешно удалён."

msgid "Your preview translation has been deleted successfully."
msgstr "Перевод вашего предпросмотра успешно удалён."

msgid "<b>File types:</b> %s<br />"
msgstr "<b>Типы файлов:</b> %s<br />"
