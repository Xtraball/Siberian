msgid "The password must be at least 9 characters"
msgstr "Пароль должен содержать не менее 9 символов"

# GMT 1580382615.6837
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Password should be at least %s characters in length and should include at least one upper case letter, one number, and one special character."
msgstr "Пароль должен содержать не менее %s символов, включая хотя бы одну заглавную букву, одну цифру и один специальный символ."

# GMT 1793000000.0001
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "This version is already installed"
msgstr "Эта версия уже установлена"

# GMT 1793000000.0002
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Would you like to reinstall it? Files are copied again and the module schema and data are synchronized again."
msgstr "Хотите переустановить ее? Файлы будут скопированы заново, а схема и данные модуля синхронизированы повторно."

# GMT 1793000000.0003
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Yes, reinstall"
msgstr "Да, переустановить"

# GMT 1793000000.0004
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "No, cancel"
msgstr "Нет, отмена"

# GMT 1793100000.0001
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The license saved for this module is expired or no longer valid. If you received a new key, enter it here, or keep the current one."
msgstr "Лицензия, сохраненная для этого модуля, истекла или более недействительна. Если вы получили новый ключ, введите его здесь или оставьте текущий."

# GMT 1793100000.0002
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Keep the current key"
msgstr "Оставить текущий ключ"

