msgstr "Ядро"

# GMT 1793100001.0002
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "App sources"
msgstr "Исходники приложений"

# GMT 1793100001.0003
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Modified"
msgstr "Изменено"

# GMT 1793100001.0004
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Missing"
msgstr "Отсутствует"

# GMT 1793100001.0005
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Unreadable"
msgstr "Нечитаемо"

# GMT 1793100001.0006
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "File"
msgstr "Файл"

# GMT 1793100001.0007
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Status"
msgstr "Статус"

# GMT 1793100001.0008
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Area"
msgstr "Область"

# GMT 1793100001.0009
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Files checked"
msgstr "Проверено файлов"

# GMT 1793100001.0010
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Core files only, skip the app sources (faster)"
msgstr "Только файлы ядра, без исходников приложений (быстрее)"

# GMT 1793100001.0011
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Module installations and generated apps also write in the app sources, differences there are not necessarily a problem."
msgstr "Установка модулей и сгенерированные приложения также записывают данные в исходники приложений, поэтому различия там не обязательно являются проблемой."

# GMT 1793100001.0012
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The file manifest.json is missing, the integrity cannot be checked."
msgstr "Файл manifest.json отсутствует, проверить целостность невозможно."

# GMT 1793100001.0013
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The file manifest.json is not valid, the integrity cannot be checked."
msgstr "Файл manifest.json недействителен, проверить целостность невозможно."

# GMT 1793100001.0014
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Edit my account"
msgstr "Редактировать мою учетную запись"

# GMT 1793100001.0015
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Show / hide"
msgstr "Показать / скрыть"

# GMT 1793100001.0030
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "This job has no command."
msgstr "У этого задания нет команды."

# GMT 1793100001.0031
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The class %s does not exist, the module providing this job is probably disabled or removed."
msgstr "Класс %s не существует, вероятно, модуль, предоставляющий это задание, отключен или удален."

# GMT 1793100001.0032
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The class %s can not be loaded: %s"
msgstr "Не удалось загрузить класс %s: %s"

# GMT 1793100001.0033
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s does not exist."
msgstr "Метод %s не существует."

# GMT 1793100001.0034
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s is not public."
msgstr "Метод %s не является публичным."

# GMT 1793100001.0035
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s is abstract."
msgstr "Метод %s является абстрактным."

# GMT 1793100001.0036
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s requires %d arguments, a job is given %d."
msgstr "Метод %s требует аргументов: %d, а заданию передано: %d."

# GMT 1793100001.0037
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The class %s can not be instantiated, declare the method %s static."
msgstr "Невозможно создать экземпляр класса %s, объявите метод %s статическим."

# GMT 1793100001.0038
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s is not static and the constructor of %s requires arguments, declare the method static."
msgstr "Метод %s не является статическим, а конструктору %s нужны аргументы, объявите метод статическим."

# GMT 1793100001.0039
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s is not static. PHP 8 can not call it statically, the scheduler runs it on a new instance instead; declare it static."
msgstr "Метод %s не является статическим. PHP 8 не может вызвать его статически, планировщик вместо этого запускает его на новом экземпляре; объявите его статическим."

# GMT 1793100001.0040
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "This job can run."
msgstr "Это задание может быть выполнено."

# GMT 1793100001.0041
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Compatibility with PHP"
msgstr "Совместимость с PHP"

# GMT 1793100001.0042
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Every job is checked against the PHP version that runs the scheduler, without running it."
msgstr "Каждое задание проверяется на соответствие версии PHP, под которой работает планировщик, без его запуска."

# GMT 1793100001.0043
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "PHP version"
msgstr "Версия PHP"

# GMT 1793100001.0044
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Active jobs checked"
msgstr "Проверено активных заданий"

# GMT 1793100001.0045
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "All the active jobs can be run by the scheduler."
msgstr "Планировщик может выполнить все активные задания."

# GMT 1793100001.0046
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "A job that can not run is skipped and reported, it never stops the other jobs."
msgstr "Задание, которое не может быть выполнено, пропускается и попадает в отчет, при этом остальные задания не останавливаются."

# GMT 1793100001.0047
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Job"
msgstr "Задание"

# GMT 1793100001.0048
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Problem"
msgstr "Проблема"

# GMT 1793100001.0049
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Last error"
msgstr "Последняя ошибка"

# GMT 1793100001.0050
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Compatibility"
msgstr "Совместимость"

# GMT 1793100001.0051
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Some cron jobs can not run with this PHP version:"
msgstr "Некоторые cron-задания не могут работать с этой версией PHP:"

# GMT 1793100001.0052
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "see the details"
msgstr "подробнее"

# GMT 1793100001.0060
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Modules in quarantine"
msgstr "Модули в карантине"

# GMT 1793100001.0061
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "A module stopped the application with a fatal error, or is not compatible with this version of Siberian or PHP. It is disabled until it is rechecked, the rest of the application keeps working."
msgstr "Модуль остановил приложение из-за критической ошибки или несовместим с этой версией Siberian или PHP. Он отключен до повторной проверки, остальное приложение продолжает работать."

# GMT 1793100001.0062
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Needs a newer Siberian"
msgstr "Требуется более новая версия Siberian"

# GMT 1793100001.0063
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Failed the compatibility check"
msgstr "Не прошел проверку совместимости"

# GMT 1793100001.0064
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Fatal error"
msgstr "Критическая ошибка"

# GMT 1793100001.0065
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Updated since, recheck it to enable it again."
msgstr "С тех пор обновлен, перепроверьте его, чтобы снова включить."

# GMT 1793100001.0066
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Recheck"
msgstr "Перепроверить"

# GMT 1793100001.0067
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Re-enable"
msgstr "Включить снова"

# GMT 1793100001.0068
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Enable this module anyway? If it breaks the application again it goes back to quarantine."
msgstr "Всё равно включить этот модуль? Если он снова нарушит работу приложения, он вернется в карантин."

# GMT 1793100001.0069
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Recheck all"
msgstr "Перепроверить все"

# GMT 1793100001.0070
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Scan all modules"
msgstr "Проверить все модули"

# GMT 1793100001.0071
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "PHP or Siberian changed since the last compatibility scan of your modules."
msgstr "PHP или Siberian изменились с момента последней проверки совместимости ваших модулей."

# GMT 1793100001.0072
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Quarantine"
msgstr "Карантин"

# GMT 1793100001.0073
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Recheck done, %s released."
msgstr "Повторная проверка завершена, снято с карантина: %s."

# GMT 1793100001.0074
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The module is enabled again."
msgstr "Модуль снова включен."

# GMT 1793100001.0075
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The scan started, it can take a few minutes, reload this page to see the result."
msgstr "Проверка запущена, она может занять несколько минут, перезагрузите страницу, чтобы увидеть результат."

# GMT 1793100001.0076
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The scan could not be started, run \"php cli module:quarantine scan\" instead."
msgstr "Не удалось запустить проверку, выполните вместо этого \"php cli module:quarantine scan\"."
