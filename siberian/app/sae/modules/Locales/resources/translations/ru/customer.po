msgid "A request to reset your password has been made."
msgstr "Был сделан запрос на сброс пароля."

msgid ""
"An error occurred while connecting to your Facebook account. Please try "
"again later"
msgstr ""
"Произошла ошибка при подключении к вашей учетной записи Facebook. "
"Пожалуйста, повторите попытку позже."

msgid "Are you sure you want to remove this user?"
msgstr "Вы уверены, что хотите удалить этого пользователя?"

msgid "Change Password"
msgstr "Изменить Пароль"

msgid "Civility"
msgstr "Обращение"

msgid "Congratulations,"
msgstr "Поздравляем,"

msgid "Create"
msgstr "Создать"

msgid "Create a new user"
msgstr "Создание нового пользователя"

msgid "Customer"
msgstr "Клиент"

msgid "Customers"
msgstr "Клиенты"

msgid "Disconnect"
msgstr "Отключить"

msgid "Edit the user %s"
msgstr "Редактирование пользователя %s"

msgid "First name"
msgstr "Имя"

msgid "Here are your credentials:"
msgstr "Вот ваши учётные данные:"

msgid "I accept the privacy policy"
msgstr "Я принимаю политику конфиденциальности"

msgid "If you encounter any problems, do not hesitate to contact us:"
msgstr "Если у вас возникли проблемы, не стесняйтесь обращаться к нам:"

msgid "Last name"
msgstr "Фамилия"

msgid "Login:"
msgstr "Логин:"

msgid "Log-in with Facebook"
msgstr "Войти в систему с Facebook"

msgid "Miss"
msgstr "Мисс"

msgid "Mr"
msgstr "Мистер"

msgid "Mrs"
msgstr "Миссис"

msgid "My Account"
msgstr "Мой аккаунт"

msgid "My application's users"
msgstr "Пользователи моего приложения"

msgid "No user for now."
msgstr "Сейчас нет пользователей"

msgid "No user match your request."
msgstr "Нет пользователей, соответствующих запросу"

msgid "Or with your account"
msgstr "Или с вашей учётной записью"

msgid ""
"Please enter your email address. We'll send you your password right now."
msgstr ""
"Пожалуйста, введите Ваш адрес электронной почты. Мы вышлем вам пароль сейчас."

msgid "Please log in with your mobile phone"
msgstr "Пожалуйста, войдите с помощью мобильного телефона"

msgid "See you soon,"
msgstr "До скорой встречи,"

msgid "Show me in ranking"
msgstr "Покажите меня в рейтинге"

msgid "The old email address does not match the entered email address."
msgstr "Старый адрес электронной почты не совпадает с введённым адресом."

msgid "This user is visible in ranking"
msgstr "Пользователь виден в рейтинге"

msgid "Title"
msgstr "Название"

msgid "User"
msgstr "Пользователь"

msgid "User Information"
msgstr "Информация о пользователе"

msgid "Users"
msgstr "Пользователи"

msgid ""
"We are sorry but the %s account is already linked to one of our customers"
msgstr "Мы сожалеем, но счет %s уже связан с одним из наших клиентов"

msgid "We are sorry but this nickname is already used"
msgstr "Мы сожалеем, но этот псевдоним уже используется"

msgid ""
"We are sorry but this nickname is not valid. Use only alphanumerical "
"characters and underscores and use 15 characters maximum"
msgstr "Нам очень жаль, но этот псевдоним недопустим. Используйте только буквы, цифры и знаки подчёркивания, не более 15 символов"

msgid ""
"You have created your account. With this account, you will be able to enjoy "
"great offers available in our application."
msgstr "Вы создали свой аккаунт. С этой учётной записью вы сможете пользоваться отличными предложениями в нашем приложении."

msgid "You must agree to our privacy policy to create an account."
msgstr ""
"Вы должны согласиться с нашей политикой конфиденциальности, чтобы создать "
"учетную запись."

msgid "You must fill firstname and lastname fields."
msgstr "Вы должны заполнить имя и фамилию."

msgid "Your account has been successfully saved"
msgstr "Ваша учетная запись была успешно сохранена"

msgid "Your points"
msgstr "Ваши баллы"

msgid "%s - Account creation"
msgstr "%s - Создание учетной записи"

msgid "%s - Your new password"
msgstr "%s - Ваш новый пароль"

