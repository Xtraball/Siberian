msgid "Additionnal Information"
msgstr "Дополнительная информация"

msgid "An error occurred while deleting the push. Please try again later."
msgstr "Произошла ошибка при удалении push-сообщения. Пожалуйста, повторите попытку позже."

msgid "And a radius (in Km):"
msgstr "И радиус (в км):"

msgid "Android"
msgstr "Android"

msgid "Creation date"
msgstr "Дата создания"

msgid "Custom URL"
msgstr "Пользовательский URL"

msgid "Enter a location:"
msgstr "Введите местоположение:"

msgid "GCM Key"
msgstr "GCM ключ"

msgid "I want to send it"
msgstr "Я хочу отправить Push-сообщение"

msgid "Keys successfully saved"
msgstr "Ключи успешно сохранены"

msgid "Message"
msgstr "Сообщение"

msgid "No device found for this user"
msgstr "Не найдено устройство для данного пользователя"

msgid "No items."
msgstr "Нет элементов."

msgid "Open a feature or a custom URL"
msgstr "Открыть функцию или пользовательский URL"

msgid "Pending"
msgstr "В ожидании"

msgid "Please enter an expiration date for your message:"
msgstr "Пожалуйста, введите дату истечения срока действия Вашего сообщения:"

msgid "Project Number"
msgstr "Номер Проекта"

msgid "Push Notifications"
msgstr "Push-уведомления"

msgid "Push Notifications Settings"
msgstr "Настройки push-уведомлений"

msgid "Push successfully deleted."
msgstr "Push-сообщение успешно удалено."

msgid "Radius"
msgstr "Радиус"

msgid "Send to a specific location"
msgstr "Отправить в определенное место"

msgid "Send to all applications"
msgstr "Послать всем приложениям"

msgid "Send to all my users"
msgstr "Послать всем своим пользователям"

msgid "Send to no specific locations"
msgstr "Отправить без привязки к местоположению"

msgid "Send to specific topics"
msgstr "Отправить по определённым темам"

msgid "Send to specific users"
msgstr "Отправить определенным пользователям"

msgid "Sending date"
msgstr "Дата отправки"

msgid "The duration limit must be higher than the sent date"
msgstr "Срок действия должен быть позже даты отправки"

msgid "Topics"
msgstr "Темы"

msgid "Users"
msgstr "Пользователи"

msgid "You must choose a topic before sending your message."
msgstr "Вы должны выбрать тему перед отправкой сообщения."

msgid "You must choose at least one user before sending your message."
msgstr "Вы должны выбрать хотя бы одного пользователя перед отправкой сообщения."

msgid "Your app must be published to send a push notification."
msgstr "Ваше приложение должно быть опубликовано, чтобы отправлять push-уведомления."

msgid "Your message has been saved successfully."
msgstr "Ваше сообщение успешно сохранено."

msgid ""
"Your message has been saved successfully and will be sent at the entered date"
msgstr ""
"Ваше сообщение было успешно сохранено и будет отправлено в указанную дату."

msgid ""
"Your message has been saved successfully and will be sent in a few minutes"
msgstr ""
"Ваше сообщение было успешно сохранено и будет отправлено в течение "
"нескольких минут."

msgid "and users entering the area"
msgstr "и пользователям при входе в зону"

msgid "for a limited period"
msgstr "в течение ограниченного периода"

msgid "now"
msgstr "сейчас"

msgid "on a specific date"
msgstr "на определенную дату"
