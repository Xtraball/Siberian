# GMT 1580382615.6836
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The password must be at least 9 characters"
msgstr "Het wachtwoord moet minstens 9 tekens bevatten"

# GMT 1580382615.6837
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Password should be at least %s characters in length and should include at least one upper case letter, one number, and one special character."
msgstr "Het wachtwoord moet minstens %s tekens lang zijn en minstens één hoofdletter, één cijfer en één speciaal teken bevatten."

# GMT 1793000000.0001
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "This version is already installed"
msgstr "Deze versie is al geïnstalleerd"

# GMT 1793000000.0002
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Would you like to reinstall it? Files are copied again and the module schema and data are synchronized again."
msgstr "Wilt u deze opnieuw installeren? De bestanden worden opnieuw gekopieerd en het schema en de gegevens van de module worden opnieuw gesynchroniseerd."

# GMT 1793000000.0003
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Yes, reinstall"
msgstr "Ja, opnieuw installeren"

# GMT 1793000000.0004
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "No, cancel"
msgstr "Nee, annuleren"

# GMT 1793100000.0001
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The license saved for this module is expired or no longer valid. If you received a new key, enter it here, or keep the current one."
msgstr "De voor deze module opgeslagen licentie is verlopen of niet meer geldig. Als u een nieuwe sleutel heeft ontvangen, voer die dan hier in, of behoud de huidige."

# GMT 1793100000.0002
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Keep the current key"
msgstr "Huidige sleutel behouden"

