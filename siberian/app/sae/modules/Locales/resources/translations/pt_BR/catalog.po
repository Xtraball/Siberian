msgid "Add a category"
msgstr "Adicionar uma categoria"

msgid "Add a format"
msgstr "Adicionar um formato"

msgid "Add a new product"
msgstr "Criar um novo produto"

msgid "All"
msgstr "Todos"

msgid "An error occurred while loading your product."
msgstr "Ocorreu um erro ao carregar o seu produto."

msgid ""
"An error occurred while saving. One of your categories could not be "
"identified."
msgstr "Ocorreu um erro ao salvar. Uma de suas categorias não pôde ser identificada."

msgid ""
"An error occurred while saving. One of your products could not be identified."
msgstr "Ocorreu um erro ao salvar. Um de seus produtos não pôde ser identificado."

msgid "An error occurred while saving the category. Please try again later."
msgstr ""
"Ocorreu um erro ao salvar a categoria. Por favor, tente novamente mais tarde."

msgid "An error occurred while saving the product. Please try again later."
msgstr ""
"Ocorreu um erro ao salvar o produto. Por favor, tente novamente mais tarde."

msgid "An error occurred while saving the set meal. Please try again later."
msgstr ""
"Ocorreu um erro ao salvar a refeição. Por favor, tente novamente mais tarde."

msgid "Are you sure you want to delete this category?"
msgstr "Tem certeza de que deseja excluir esta categoria?"

msgid ""
"Are you sure you want to delete this category and all its subcategories?"
msgstr ""
"Tem certeza de que deseja excluir esta categoria e todas as suas "
"subcategorias?"

msgid "Are you sure you want to delete this product?"
msgstr "Tem certeza de que deseja excluir este produto?"

