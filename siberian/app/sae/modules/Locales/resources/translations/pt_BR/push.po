msgstr "Seu aplicativo deve ser publicado para enviar uma notificação push."

msgid "Your message has been saved successfully."
msgstr "Sua mensagem foi salva com sucesso."

msgid ""
"Your message has been saved successfully and will be sent at the entered date"
msgstr "Sua mensagem foi salva com sucesso e será enviada na data que você digitou."

msgid ""
"Your message has been saved successfully and will be sent in a few minutes"
msgstr "Sua mensagem foi salva com sucesso e será enviada em poucos minutos"

msgid "and users entering the area"
msgstr "e os usuários que entrarem na área"

