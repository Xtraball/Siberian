msgstr "Álbuns"

msgid ""
"An error occurred while deleting you images gallery. Please try again later."
msgstr ""
"Ocorreu um erro ao excluir a galeria de imagens. Por favor, tente novamente "
"mais tarde."

msgid "An error occurred while deleting your album. Thanks for trying later."
msgstr ""
"Ocorreu um erro durante a exclusão de seu álbum. Obrigado. Tente mais tarde."

msgid ""
"An error occurred while deleting your playlist. Thanks for trying later."
msgstr "Ocorreu um erro ao excluir sua playlist. Obrigado. Tente mais tarde."

msgid "An error occurred while deleting your track. Thanks for trying later."
msgstr ""
"Ocorreu um erro durante a exclusão de sua faixa. Obrigado. Tente mais tarde."

msgid "An error occurred while loading pictures. Please try later."
msgstr "Ocorreu um erro ao carregar imagens. Por favor, tente mais tarde."

msgid "An error occurred while loading the media."
msgstr "Ocorreu um erro ao carregar a mídia."

msgid "An error occurred while loading the radio."
msgstr "Ocorreu um erro ao carregar a rádio."

msgid "An error occurred while loading videos. Please try later."
msgstr "Ocorreu um erro ao carregar vídeos. Por favor, tente mais tarde."

#. machine-translated (2026-10), to be reviewed
msgid ""
"An error occurred while retrieving your page. Please check your page id."
msgstr "Ocorreu um erro ao obter sua página. Verifique o ID da sua página."

msgid ""
"An error occurred while saving your images gallery. Please try again later."
msgstr ""
"Ocorreu um erro ao salvar a sua galeria de imagens. Por favor, tente "
"novamente mais tarde."

msgid "An error occurred while saving your playlist. Thanks for trying later."
msgstr "Ocorreu um erro ao salvar a sua playlist. Obrigado. Tente mais tarde."

msgid ""
"An error occurred while saving your videos gallery. Please try again later."
msgstr ""
"Ocorreu um erro ao salvar a sua galeria de vídeos. Por favor, tente "
"novamente mais tarde."

