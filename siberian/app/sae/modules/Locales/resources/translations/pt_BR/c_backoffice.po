# GMT 1793100001.0010
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Core files only, skip the app sources (faster)"
msgstr "Somente arquivos do núcleo, ignorar os códigos-fonte do app (mais rápido)"

# GMT 1793100001.0011
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Module installations and generated apps also write in the app sources, differences there are not necessarily a problem."
msgstr "As instalações de módulos e os apps gerados também gravam nos códigos-fonte do app; diferenças ali não são necessariamente um problema."

# GMT 1793100001.0012
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The file manifest.json is missing, the integrity cannot be checked."
msgstr "O arquivo manifest.json está ausente, a integridade não pode ser verificada."

# GMT 1793100001.0013
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The file manifest.json is not valid, the integrity cannot be checked."
msgstr "O arquivo manifest.json não é válido, a integridade não pode ser verificada."

# GMT 1793100001.0014
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Edit my account"
msgstr "Editar minha conta"

# GMT 1793100001.0015
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Show / hide"
msgstr "Mostrar / ocultar"

# GMT 1793100001.0030
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "This job has no command."
msgstr "Este job não tem comando."

# GMT 1793100001.0031
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The class %s does not exist, the module providing this job is probably disabled or removed."
msgstr "A classe %s não existe; o módulo que fornece este job provavelmente está desativado ou removido."

# GMT 1793100001.0032
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The class %s can not be loaded: %s"
msgstr "A classe %s não pôde ser carregada: %s"

# GMT 1793100001.0033
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s does not exist."
msgstr "O método %s não existe."

# GMT 1793100001.0034
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s is not public."
msgstr "O método %s não é público."

# GMT 1793100001.0035
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s is abstract."
msgstr "O método %s é abstrato."

# GMT 1793100001.0036
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s requires %d arguments, a job is given %d."
msgstr "O método %s exige %d argumentos, mas o job recebeu %d."

# GMT 1793100001.0037
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The class %s can not be instantiated, declare the method %s static."
msgstr "A classe %s não pode ser instanciada; declare o método %s como static."

# GMT 1793100001.0038
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s is not static and the constructor of %s requires arguments, declare the method static."
msgstr "O método %s não é static e o construtor de %s exige argumentos; declare o método como static."

# GMT 1793100001.0039
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s is not static. PHP 8 can not call it statically, the scheduler runs it on a new instance instead; declare it static."
msgstr "O método %s não é static. O PHP 8 não pode chamá-lo estaticamente; o agendador o executa em uma nova instância; declare-o como static."

# GMT 1793100001.0040
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "This job can run."
msgstr "Este job pode ser executado."

# GMT 1793100001.0041
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Compatibility with PHP"
msgstr "Compatibilidade com o PHP"

# GMT 1793100001.0042
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Every job is checked against the PHP version that runs the scheduler, without running it."
msgstr "Cada job é verificado em relação à versão do PHP que executa o agendador, sem executá-lo."

# GMT 1793100001.0043
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "PHP version"
msgstr "Versão do PHP"

# GMT 1793100001.0044
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Active jobs checked"
msgstr "Jobs ativos verificados"

# GMT 1793100001.0045
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "All the active jobs can be run by the scheduler."
msgstr "Todos os jobs ativos podem ser executados pelo agendador."

# GMT 1793100001.0046
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "A job that can not run is skipped and reported, it never stops the other jobs."
msgstr "Um job que não pode ser executado é ignorado e reportado, e nunca interrompe os outros jobs."

# GMT 1793100001.0047
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Job"
msgstr "Emprego"

# GMT 1793100001.0048
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Problem"
msgstr "Problema"

# GMT 1793100001.0049
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Last error"
msgstr "Último erro"

# GMT 1793100001.0050
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Compatibility"
msgstr "Compatibilidade"

# GMT 1793100001.0051
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Some cron jobs can not run with this PHP version:"
msgstr "Alguns jobs do cron não podem ser executados com esta versão do PHP:"

# GMT 1793100001.0052
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "see the details"
msgstr "ver os detalhes"

# GMT 1793100001.0060
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Modules in quarantine"
msgstr "Módulos em quarentena"

# GMT 1793100001.0061
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "A module stopped the application with a fatal error, or is not compatible with this version of Siberian or PHP. It is disabled until it is rechecked, the rest of the application keeps working."
msgstr "Um módulo interrompeu o aplicativo com um erro fatal ou não é compatível com esta versão do Siberian ou do PHP. Ele fica desativado até ser verificado novamente; o restante do aplicativo continua funcionando."

# GMT 1793100001.0062
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Needs a newer Siberian"
msgstr "Requer um Siberian mais recente"

# GMT 1793100001.0063
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Failed the compatibility check"
msgstr "Reprovado na verificação de compatibilidade"

# GMT 1793100001.0064
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Fatal error"
msgstr "Erro fatal"

# GMT 1793100001.0065
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Updated since, recheck it to enable it again."
msgstr "Atualizado desde então; verifique novamente para ativá-lo outra vez."

# GMT 1793100001.0066
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Recheck"
msgstr "Verificar novamente"

# GMT 1793100001.0067
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Re-enable"
msgstr "Reativar"

# GMT 1793100001.0068
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Enable this module anyway? If it breaks the application again it goes back to quarantine."
msgstr "Ativar este módulo mesmo assim? Se ele quebrar o aplicativo novamente, voltará para a quarentena."

# GMT 1793100001.0069
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Recheck all"
msgstr "Verificar todos novamente"

# GMT 1793100001.0070
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Scan all modules"
msgstr "Analisar todos os módulos"

# GMT 1793100001.0071
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "PHP or Siberian changed since the last compatibility scan of your modules."
msgstr "O PHP ou o Siberian mudou desde a última análise de compatibilidade dos seus módulos."

# GMT 1793100001.0072
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Quarantine"
msgstr "Quarentena"

# GMT 1793100001.0073
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Recheck done, %s released."
msgstr "Verificação concluída, %s liberado(s)."

# GMT 1793100001.0074
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The module is enabled again."
msgstr "O módulo foi ativado novamente."

# GMT 1793100001.0075
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The scan started, it can take a few minutes, reload this page to see the result."
msgstr "A análise foi iniciada e pode levar alguns minutos; recarregue esta página para ver o resultado."

# GMT 1793100001.0076
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The scan could not be started, run \"php cli module:quarantine scan\" instead."
msgstr "Não foi possível iniciar a análise; execute \"php cli module:quarantine scan\" no lugar."
