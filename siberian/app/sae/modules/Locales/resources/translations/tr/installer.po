msgstr "Lütfen tüm alanları doldurunuz"

msgid ""
"Please update the module to the %s version before installing this update."
msgstr "Bu güncellemeyi yüklemeden önce lütfen modülü %s sürümüne güncelleyin."

msgid ""
"Please update your system to the %s version before installing this update."
msgstr "Bu güncellemeyi yüklemeden önce lütfen sisteminizi %s sürümüne güncelleyin."

