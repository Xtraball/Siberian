# GMT 1793100001.0012
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The file manifest.json is missing, the integrity cannot be checked."
msgstr "manifest.json dosyası eksik, bütünlük kontrol edilemiyor."

# GMT 1793100001.0013
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The file manifest.json is not valid, the integrity cannot be checked."
msgstr "manifest.json dosyası geçerli değil, bütünlük kontrol edilemiyor."

# GMT 1793100001.0014
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Edit my account"
msgstr "Hesabımı düzenle"

# GMT 1793100001.0015
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Show / hide"
msgstr "Göster / gizle"

# GMT 1793100001.0030
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "This job has no command."
msgstr "Bu görevin komutu yok."

# GMT 1793100001.0031
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The class %s does not exist, the module providing this job is probably disabled or removed."
msgstr "%s sınıfı mevcut değil, bu görevi sağlayan modül muhtemelen devre dışı veya kaldırılmış."

# GMT 1793100001.0032
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The class %s can not be loaded: %s"
msgstr "%s sınıfı yüklenemiyor: %s"

# GMT 1793100001.0033
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s does not exist."
msgstr "%s metodu mevcut değil."

# GMT 1793100001.0034
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s is not public."
msgstr "%s metodu public değil."

# GMT 1793100001.0035
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s is abstract."
msgstr "%s metodu soyut (abstract)."

# GMT 1793100001.0036
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s requires %d arguments, a job is given %d."
msgstr "%s metodu %d bağımsız değişken gerektiriyor, göreve %d verilmiş."

# GMT 1793100001.0037
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The class %s can not be instantiated, declare the method %s static."
msgstr "%s sınıfı örneklenemiyor, %s metodunu static olarak tanımlayın."

# GMT 1793100001.0038
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s is not static and the constructor of %s requires arguments, declare the method static."
msgstr "%s metodu static değil ve %s yapıcısı bağımsız değişken gerektiriyor, metodu static olarak tanımlayın."

# GMT 1793100001.0039
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s is not static. PHP 8 can not call it statically, the scheduler runs it on a new instance instead; declare it static."
msgstr "%s metodu static değil. PHP 8 onu statik olarak çağıramaz, zamanlayıcı bunun yerine yeni bir örnek üzerinde çalıştırır; static olarak tanımlayın."

# GMT 1793100001.0040
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "This job can run."
msgstr "Bu görev çalışabilir."

# GMT 1793100001.0041
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Compatibility with PHP"
msgstr "PHP uyumluluğu"

# GMT 1793100001.0042
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Every job is checked against the PHP version that runs the scheduler, without running it."
msgstr "Her görev, çalıştırılmadan, zamanlayıcıyı çalıştıran PHP sürümüne göre kontrol edilir."

# GMT 1793100001.0043
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "PHP version"
msgstr "PHP sürümü"

# GMT 1793100001.0044
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Active jobs checked"
msgstr "Kontrol edilen etkin görevler"

# GMT 1793100001.0045
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "All the active jobs can be run by the scheduler."
msgstr "Tüm etkin görevler zamanlayıcı tarafından çalıştırılabilir."

# GMT 1793100001.0046
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "A job that can not run is skipped and reported, it never stops the other jobs."
msgstr "Çalışamayan bir görev atlanır ve bildirilir, diğer görevleri asla durdurmaz."

# GMT 1793100001.0047
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Job"
msgstr "Görev"

# GMT 1793100001.0048
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Problem"
msgstr "Sorun"

# GMT 1793100001.0049
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Last error"
msgstr "Son hata"

# GMT 1793100001.0050
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Compatibility"
msgstr "Uyumluluk"

# GMT 1793100001.0051
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Some cron jobs can not run with this PHP version:"
msgstr "Bazı cron görevleri bu PHP sürümüyle çalışamıyor:"

# GMT 1793100001.0052
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "see the details"
msgstr "ayrıntıları gör"

# GMT 1793100001.0060
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Modules in quarantine"
msgstr "Karantinadaki modüller"

# GMT 1793100001.0061
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "A module stopped the application with a fatal error, or is not compatible with this version of Siberian or PHP. It is disabled until it is rechecked, the rest of the application keeps working."
msgstr "Bir modül uygulamayı ölümcül bir hatayla durdurdu veya bu Siberian ya da PHP sürümüyle uyumlu değil. Yeniden kontrol edilene kadar devre dışıdır, uygulamanın geri kalanı çalışmaya devam eder."

# GMT 1793100001.0062
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Needs a newer Siberian"
msgstr "Daha yeni bir Siberian gerekir"

# GMT 1793100001.0063
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Failed the compatibility check"
msgstr "Uyumluluk kontrolünden geçemedi"

# GMT 1793100001.0064
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Fatal error"
msgstr "Ölümcül hata"

# GMT 1793100001.0065
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Updated since, recheck it to enable it again."
msgstr "Sonradan güncellendi, tekrar etkinleştirmek için yeniden kontrol edin."

# GMT 1793100001.0066
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Recheck"
msgstr "Yeniden kontrol et"

# GMT 1793100001.0067
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Re-enable"
msgstr "Yeniden etkinleştir"

# GMT 1793100001.0068
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Enable this module anyway? If it breaks the application again it goes back to quarantine."
msgstr "Bu modül yine de etkinleştirilsin mi? Uygulamayı tekrar bozarsa karantinaya geri döner."

# GMT 1793100001.0069
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Recheck all"
msgstr "Tümünü yeniden kontrol et"

# GMT 1793100001.0070
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Scan all modules"
msgstr "Tüm modülleri tara"

# GMT 1793100001.0071
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "PHP or Siberian changed since the last compatibility scan of your modules."
msgstr "Modüllerinizin son uyumluluk taramasından bu yana PHP veya Siberian değişti."

# GMT 1793100001.0072
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Quarantine"
msgstr "Karantina"

# GMT 1793100001.0073
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Recheck done, %s released."
msgstr "Yeniden kontrol tamamlandı, %s serbest bırakıldı."

# GMT 1793100001.0074
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The module is enabled again."
msgstr "Modül yeniden etkinleştirildi."

# GMT 1793100001.0075
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The scan started, it can take a few minutes, reload this page to see the result."
msgstr "Tarama başlatıldı, birkaç dakika sürebilir, sonucu görmek için bu sayfayı yeniden yükleyin."

# GMT 1793100001.0076
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The scan could not be started, run \"php cli module:quarantine scan\" instead."
msgstr "Tarama başlatılamadı, bunun yerine \"php cli module:quarantine scan\" komutunu çalıştırın."
