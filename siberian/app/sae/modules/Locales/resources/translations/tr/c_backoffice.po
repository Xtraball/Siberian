# GMT 1793000000.0001
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "This version is already installed"
msgstr "Bu sürüm zaten yüklü"

# GMT 1793000000.0002
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Would you like to reinstall it? Files are copied again and the module schema and data are synchronized again."
msgstr "Yeniden yüklemek ister misiniz? Dosyalar yeniden kopyalanır ve modül şeması ile verileri yeniden senkronize edilir."

# GMT 1793000000.0003
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Yes, reinstall"
msgstr "Evet, yeniden yükle"

# GMT 1793000000.0004
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "No, cancel"
msgstr "Hayır, iptal et"

# GMT 1793100000.0001
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The license saved for this module is expired or no longer valid. If you received a new key, enter it here, or keep the current one."
msgstr "Bu modül için kaydedilen lisansın süresi dolmuş veya artık geçerli değil. Yeni bir anahtar aldıysanız buraya girin veya mevcut anahtarı koruyun."

# GMT 1793100000.0002
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Keep the current key"
msgstr "Mevcut anahtarı koru"

