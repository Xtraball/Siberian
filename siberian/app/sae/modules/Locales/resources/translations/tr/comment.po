msgstr "Bilgi başarıyla gizlendi"

msgid "Information successfully saved"
msgstr "Bilgi başarıyla kaydedildi"

msgid "Information successfully shown"
msgstr "Bilgi başarıyla gösterildi"

msgid "Insert a"
msgstr "Ekle"

msgid "It will be visible only after validation by our team."
msgstr "Yalnızca ekibimiz tarafından doğrulandıktan sonra görünür olacaktır."

msgid "My customers answers"
msgstr "Müşterilerimin cevapları"

msgid "My customers' comments"
msgstr "Müşterilerimin yorumları"

msgid "Near me"
msgstr "Yakınımda"

msgid "'Near me' radius (in km):"
msgstr "'Yakınımda' yarıçap (km):"

msgid "Near me settings"
msgstr "Yakınımda ayarları"

