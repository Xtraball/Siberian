msgstr "Bir haber oluştur"

msgid "Delete this info"
msgstr "Bu bilgiyi sil"

msgid "Flag"
msgstr "Bayrak"

msgid "Flag as inappropriate"
msgstr "Uygunsuz olarak işaretle"

msgid "Hide this info"
msgstr "Bu bilgiyi gizle"

msgid "Information successfully deleted"
msgstr "Bilgi başarıyla silindi"

