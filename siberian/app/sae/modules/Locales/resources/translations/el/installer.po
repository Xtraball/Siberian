msgid "Action"
msgstr "Ενέργεια"

msgid "Actions"
msgstr "Ενέργειες"

msgid "All of your modules are up to date"
msgstr "Όλα τα πρόσθετά σας είναι ενημερωμένα"

#. machine-translated (2026-10), to be reviewed
msgid "An update is available. Click here to download it."
msgstr "Διατίθεται ενημέρωση. Κάντε κλικ εδώ για λήψη."

#. machine-translated (2026-10), to be reviewed
msgid "Check for updates"
msgstr "Έλεγχος για ενημερώσεις"

#. machine-translated (2026-10), to be reviewed
msgid "Click here to see the release notes"
msgstr "Κάντε κλικ εδώ για να δείτε τις σημειώσεις έκδοσης"

msgid "Click here to send your module"
msgstr "Κάντε κλικ εδώ για να ανεβάσετε το πρόσθετό σας"

msgid "Details"
msgstr "Λεπτομέρειες"

msgid "Drop your module here"
msgstr "Αφήστε το πρόσθετο εδώ"

msgid "Host"
msgstr "Host"

#. machine-translated (2026-10), to be reviewed
msgid "Install"
msgstr "Εγκατάσταση"

msgid "Installing"
msgstr "Γίνεται εγκατάσταση"

msgid "Installing your module"
msgstr "Γίνεται εγκατάσταση του προσθέτου σας"

msgid "Module successfully installed"
msgstr "Το πρόσθετο εγκαταστάθηκε επιτυχώς"

msgid "Module to upload"
msgstr "Πρόσθετο προς ανέβασμα"

msgid "Modules Installation"
msgstr "Εγκατάσταση Προσθέτων"

msgid "Modules successfully installed!"
msgstr "Τα πρόσθετα εγκαταστάθηκαν επιτυχώς!"

msgid "Name"
msgstr "Όνομα"

msgid "No directory provided"
msgstr "Δεν έχει δηλωθεί φάκελος"

msgid "No module to install"
msgstr "Δεν υπάρχει πρόσθετο προς εγκατάσταση"

msgid "No modules uploaded yet"
msgstr "Δεν έχουν ανεβεί πρόσθετα ακόμα"

msgid ""
"Or set the correct permissions to the following files and folders and try "
"again:"
msgstr "Ή ορίστε τα σωστά δικαιώματα στα ακόλουθα αρχεία και φακέλους και δοκιμάστε ξανά:"

#. machine-translated (2026-10), to be reviewed
msgid "Package"
msgstr "Πακέτο"

msgid "Package Details"
msgstr "Πληροφορίες Πακέτου Εγκατάστασης"

msgid "Path to your system"
msgstr "Διαδρομή του συστήματός σας"

msgid "Please, enter a name"
msgstr "Παρακαλούμε συμπληρώστε ένα Όνομα"

msgid "Please, fill out all fields"
msgstr "Παρακαλούμε συμπληρώστε όλα τα πεδία"

msgid ""
"Please update the module to the %s version before installing this update."
msgstr ""
"Παρακαλούμε ενημερώστε το πρόσθετο στην έκδοση %s πριν εγκαταστήσετε αυτή "
"την ενημέρωση."

msgid ""
"Please update your system to the %s version before installing this update."
msgstr ""
"Παρακαλούμε ενημερώστε το σύστημά σας στην έκδοση %s πριν εγκαταστήσετε αυτή "
"την ενημέρωση."

msgid "Please wait, we're installing your module"
msgstr "Παρακαλούμε περιμένετε, γίνεται εγκατάσταση του προσθέτου σας"

msgid "Port"
msgstr "Θύρα"

msgid "Processing the installation"
msgstr "Γίνεται επεξεργασία της εγκατάστασης"

#. machine-translated (2026-10), to be reviewed
msgid "Progress"
msgstr "Πρόοδος"

msgid "Retry"
msgstr "Προσπαθήστε ξανά"

msgid "Select a module to upload"
msgstr "Επιλέξτε ένα πρόσθετο προς ανέβασμα"

msgid "Size"
msgstr "Μέγεθος:"

msgid ""
"Some files and folder are not writable. You can either provide your FTP "
"access to install this update:"
msgstr ""
"Κάποια αρχεία και φακέλοι δεν είναι εγγράψιμα. Μπορείτε εναλλακτικά να "
"συμπληρώσετε τα FTP στοιχεία σας για να εγκαταστήσετε αυτή την ενημέρωση:"

msgid "Some files don't have the right permissions and can't be updated"
msgstr ""
"Κάποια αρχεία δεν έχουν τα σωστά δικαιώματα και δεν γίνεται να ενημερωθούν"

msgid "Status"
msgstr "Κατάσταση"

msgid "The database connection failed. Please, check the entered information."
msgstr "Η σύνδεση με τη βάση απέτυχε. Παρακαλούμε, ελέγξτε τα στοιχεία σύνδεσης."

msgid "The entered password confirmation does not match the entered password."
msgstr "Ο Κωδικός επαλήθευσης δεν ταιριάζει με τον συμπληρωμένο Κωδικό."

msgid "The file %s does not exist"
msgstr "Το αρχείο %s δεν υπάρχει"

msgid "The file %s is not writable."
msgstr "Το αρχείο %s δεν είναι εγγράψιμο."

msgid "The folder %s is not writable. Please fix this issue and try again."
msgstr ""
"Ο φάκελος %s δεν είναι εγγράψιμος. Παρακαλούμε διορθώστε το πρόβλημα και "
"δοκιμάστε ξανά."

msgid "The following files and folders are not writable:"
msgstr "Τα ακόλουθα αρχεία και φακέλοι δεν είναι εγγράψιμα:"

msgid "The following files and folders are not writable: <br /> - %s"
msgstr "Τα ακόλουθα αρχεία και φακέλοι δεν είναι εγγράψιμα: <br /> - %s"

msgid "The package you have uploaded is invalid."
msgstr "Το Πακέτο Εγκατάστασης που ανεβάσατε, είναι μη-έγκυρο."

#. machine-translated (2026-10), to be reviewed
msgid "There is no CMS license key set."
msgstr "Δεν έχει οριστεί κλειδί άδειας CMS."

msgid "This process may take few minutes, please do not refresh the page"
msgstr ""
"Αυτή η διαδικασία μπορεί να διαρκέσει μερικά λεπτά, παρακαλούμε μην "
"ανανεώσετε την σελίδα"

msgid "This update is designed for the %s, you can't install it in your %s."
msgstr ""
"Αυτή η ενημέρωση είναι σχεδιασμένη για το %s, δεν μπορείτε να την "
"εγκαταστήσετε στο %s."

#. machine-translated (2026-10), to be reviewed
msgid "Unable to check for updates now. Please, try again later."
msgstr "Δεν είναι δυνατός ο έλεγχος για ενημερώσεις τώρα. Δοκιμάστε ξανά αργότερα."

msgid "Unable to connect to your FTP. Please check the connection information."
msgstr ""
"Δεν ήταν δυνατή η σύνδεση με FTP. Παρακαλούμε ελέγξτε τα στοιχεία σύνδεσης."

msgid ""
"Unable to detect your site. Please make sure the entered path is correct."
msgstr ""
"Δεν ήταν δυνατός ο εντοπισμός της ιστοσελίδας σας. Ελέγξτε αν η διαδρομή που "
"ορίσατε είναι η σωστή."

msgid "Unable to extract the archive."
msgstr "Δεν ήταν εφικτή η αποσυμπίεση του αρχείου."

#. machine-translated (2026-10), to be reviewed
msgid "Unable to fetch the update. Please, try again later."
msgstr "Δεν είναι δυνατή η λήψη της ενημέρωσης. Δοκιμάστε ξανά αργότερα."

msgid "Unable to open the archive."
msgstr "Δεν ήταν εφικτό το άνοιγμα του συμπιεσμένου αρχείου."

msgid ""
"Unable to open the file. Please, make sure that you sent a valid archive."
msgstr ""
"Δεν ήταν εφικτό το άνοιγμα του αρχείου. Παρακαλούμε, ελέγξτε ότι ανεβάσατε "
"ένα έγκυρο συμπιεσμένο αρχείο."

msgid "Upload a module"
msgstr "Ανεβάστε ένα πρόσθετο"

msgid "Upload your modules"
msgstr "Ανεβάστε τα πρόσθετά σας"

msgid "Username"
msgstr "Όνομα χρήστη"

msgid "Version"
msgstr "Έκδοση"

#. machine-translated (2026-10), to be reviewed
msgid "We are checking for updates. Please, do not refresh the page."
msgstr "Ελέγχουμε για ενημερώσεις. Μην ανανεώσετε τη σελίδα."

msgid "You already have installed this template."
msgstr "Έχετε ήδη εγκαταστήσει αυτό το πρότυπο."

msgid "You already have installed this update."
msgstr "Έχετε ήδη εγκαταστήσει αυτή την ενημέρωση."

#. machine-translated (2026-10), to be reviewed
msgid "Your system is up to date."
msgstr "Το σύστημά σας είναι ενημερωμένο."

msgid "%s Update"
msgstr "%s Ενημέρωση"

