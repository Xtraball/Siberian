msgid "<strong>%s</strong> must be a valid date<br />"
msgstr "Το πεδίο <strong>%s</strong> πρέπει να είναι μία έγκυρη ημ/νία<br />"

msgid "<strong>%s</strong> must be a valid email address<br />"
msgstr "Το πεδίο <strong>%s</strong> πρέπει να είναι ένα έγκυρο E-mail<br />"

msgid "<strong>%s</strong> must be filled<br />"
msgstr "Το πεδίο <strong>%s</strong> πρέπει να συμπληρωθεί<br />"

