msgid "<strong>%s</strong> is not a numerical value<br />"
msgstr "Το πεδίο <strong>%s</strong> πρέπει να έχει αριθμούς<br />"

msgid "<strong>%s</strong> is not valid email address<br />"
msgstr "Το πεδίο <strong>%s</strong> πρέπει να είναι ένα έγκυρο E-mail<br />"

msgid "<strong>%s</strong> is required<br />"
msgstr "Το πεδίο <strong>%s</strong> πρέπει να συμπληρωθεί<br />"

