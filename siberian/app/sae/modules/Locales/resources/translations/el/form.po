msgid ""
"Form data will be sent to this email. Until you fill out this field, your "
"form won't be displayed on client side."
msgstr "Τα δεδομένα της φόρμας θα σταλούν σε αυτό το email. Μέχρι να συμπληρώσετε αυτό το πεδίο, η φόρμα σας δεν θα εμφανίζεται στην πλευρά του πελάτη."

msgid "Geolocation"
msgstr "Geolocation"

msgid "Hello,"
msgstr "Γειά σας,"

