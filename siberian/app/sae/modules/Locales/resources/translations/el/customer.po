msgid "A request to reset your password has been made."
msgstr "Η αίτηση για την επαναφορά του κωδικού πρόσβασής σας έχει γίνει."

msgid ""
"An error occurred while connecting to your Facebook account. Please try "
"again later"
msgstr ""
"Παρουσιάστηκε σφάλμα κατά τη σύνδεση στο λογαριασμό σας στο Facebook. "
"Παρακαλώ δοκιμάστε ξανά αργότερα"

msgid "Are you sure you want to remove this user?"
msgstr "Είστε βέβαιοι ότι θέλετε να καταργήσετε αυτόν τον χρήστη?"

msgid "Change Password"
msgstr "Αλλαγή Κωδικού"

#. machine-translated (2026-10), to be reviewed
msgid "Civility"
msgstr "Προσφώνηση"

msgid "Congratulations,"
msgstr "Συγχαρητήρια,"

msgid "Create"
msgstr "Δημιουργώ"

msgid "Create a new user"
msgstr "Δημιουργήστε έναν νέο χρήστη"

msgid "Customer"
msgstr "Πελάτης"

msgid "Customers"
msgstr "Πελάτες"

msgid "Disconnect"
msgstr "Αποσύνδεση"

msgid "Edit the user %s"
msgstr "Επεξεργαστείτε το χρήστη%s"

msgid "First name"
msgstr "Όνομα"

msgid "Here are your credentials:"
msgstr "Εδώ είναι τα διαπιστευτήριά σας:"

#. machine-translated (2026-10), to be reviewed
msgid "I accept the privacy policy"
msgstr "Αποδέχομαι την πολιτική απορρήτου"

msgid "If you encounter any problems, do not hesitate to contact us:"
msgstr ""
"Αν αντιμετωπίσετε κάποιο πρόβλημα, μην διστάσετε να επικοινωνήσετε μαζί μας:"

msgid "Last name"
msgstr "Επώνυμο"

msgid "Login:"
msgstr "Σύνδεση :"

#. machine-translated (2026-10), to be reviewed
msgid "Log-in with Facebook"
msgstr "Σύνδεση με Facebook"

msgid "Miss"
msgstr "Δεσποινίς"

msgid "Mr"
msgstr "Κύριος"

msgid "Mrs"
msgstr "Κυρία"

msgid "My Account"
msgstr "Ο Λογαριασμός μου"

msgid "My application's users"
msgstr "Οι χρήστες των εφαρμογών μου"

#. machine-translated (2026-10), to be reviewed
msgid "No user for now."
msgstr "Κανένας χρήστης προς το παρόν."

#. machine-translated (2026-10), to be reviewed
msgid "No user match your request."
msgstr "Κανένας χρήστης δεν ταιριάζει με το αίτημά σας."

msgid "Or with your account"
msgstr "Ή με το λογαριασμό σας"

msgid ""
"Please enter your email address. We'll send you your password right now."
msgstr ""
"Παρακαλώ εισάγετε τη διεύθυνση email σας. Θα σας στείλουμε τον κωδικό "
"πρόσβασής σας τώρα."

msgid "Please log in with your mobile phone"
msgstr "Παρακαλώ συνδεθείτε με το κινητό σας τηλέφωνο"

msgid "See you soon,"
msgstr "Θα σε δώ σύντομα,"

msgid "Show me in ranking"
msgstr "Δείξε μου την κατάταξη"

msgid "The old email address does not match the entered email address."
msgstr ""
"Η παλιά διεύθυνση ηλεκτρονικού ταχυδρομείου δεν ταιριάζει με την "
"καταχωρημένη διεύθυνση ηλεκτρονικού ταχυδρομείου."

msgid "This user is visible in ranking"
msgstr "Αυτός ο χρήστης είναι ορατός στην κατάταξη"

msgid "Title"
msgstr "Τίτλος"

msgid "User"
msgstr "Χρήστης"

msgid "User Information"
msgstr "Πληροφορίες Χρήστη"

msgid "Users"
msgstr "Χρήστες"

msgid ""
"We are sorry but the %s account is already linked to one of our customers"
msgstr ""
"Λυπούμαστε, αλλά ο λογαριασμός %s είναι ήδη συνδεδεμένος με έναν από τους "
"πελάτες μας"

msgid "We are sorry but this nickname is already used"
msgstr "Συγνώμη, αλλά αυτή η διεύθυνση χρησιμοποιείται ήδη."

#. machine-translated (2026-10), to be reviewed
msgid ""
"We are sorry but this nickname is not valid. Use only alphanumerical "
"characters and underscores and use 15 characters maximum"
msgstr "Λυπούμαστε, αλλά αυτό το ψευδώνυμο δεν είναι έγκυρο. Χρησιμοποιήστε μόνο αλφαριθμητικούς χαρακτήρες και κάτω παύλες, με μέγιστο 15 χαρακτήρες"

msgid ""
"You have created your account. With this account, you will be able to enjoy "
"great offers available in our application."
msgstr ""
"Έχετε δημιουργήσει το λογαριασμό σας. Με αυτόν τον λογαριασμό, θα είστε σε "
"θέση να απολαύσετε τις υπέροχες προσφορές που είναι διαθέσιμες στην εφαρμογή "
"μας."

#. machine-translated (2026-10), to be reviewed
msgid "You must agree to our privacy policy to create an account."
msgstr "Πρέπει να συμφωνήσετε με την πολιτική απορρήτου μας για να δημιουργήσετε λογαριασμό."

#. machine-translated (2026-10), to be reviewed
msgid "You must fill firstname and lastname fields."
msgstr "Πρέπει να συμπληρώσετε τα πεδία ονόματος και επωνύμου."

msgid "Your account has been successfully saved"
msgstr "Ο λογαριασμός σας έχει αποθηκευτεί επιτυχώς"

#. machine-translated (2026-10), to be reviewed
msgid "Your points"
msgstr "Οι πόντοι σας"

msgid "%s - Account creation"
msgstr "%s - Δημιουργία Λογαριασμού"

msgid "%s - Your new password"
msgstr "%s - Ο νέος σας κωδικός"

