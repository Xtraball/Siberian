msgid "Additionnal Information"
msgstr "Συμπληρωματικές πληροφορίες"

msgid "An error occurred while deleting the push. Please try again later."
msgstr "Παρουσιάστηκε σφάλμα κατά τη διαγραφή του push μηνύματος. Παρακαλώ δοκιμάστε ξανά αργότερα."

msgid "And a radius (in Km):"
msgstr "Και μια ακτίνα (σε χλμ):"

msgid "Android"
msgstr "Android"

msgid "Creation date"
msgstr "Ημ/νία δημιουργίας"

#. machine-translated (2026-10), to be reviewed
msgid "Custom URL"
msgstr "Προσαρμοσμένο URL"

msgid "Enter a location:"
msgstr "Συμπληρώστε τοποθεσία:"

msgid "GCM Key"
msgstr "Κλειδί GCM"

msgid "I want to send it"
msgstr "Θέλω να το στείλω"

msgid "Keys successfully saved"
msgstr "Τα κλειδιά αποθηκεύτηκαν επιτυχώς"

msgid "Message"
msgstr "Μήνυμα"

#. machine-translated (2026-10), to be reviewed
msgid "No device found for this user"
msgstr "Δεν βρέθηκε συσκευή για αυτόν τον χρήστη"

#. machine-translated (2026-10), to be reviewed
msgid "No items."
msgstr "Κανένα στοιχείο."

#. machine-translated (2026-10), to be reviewed
msgid "Open a feature or a custom URL"
msgstr "Άνοιγμα λειτουργίας ή προσαρμοσμένου URL"

msgid "Pending"
msgstr "Εκκρεμεί"

#. machine-translated (2026-10), to be reviewed
msgid "Please enter an expiration date for your message:"
msgstr "Εισαγάγετε ημερομηνία λήξης για το μήνυμά σας:"

#. machine-translated (2026-10), to be reviewed
msgid "Project Number"
msgstr "Αριθμός έργου"

msgid "Push Notifications"
msgstr "Μηνύματα Push"

msgid "Push Notifications Settings"
msgstr "Ρυθμίσεις Μηνυμάτων Push"

msgid "Push successfully deleted."
msgstr "Το push μήνυμα διαγράφηκε επιτυχώς."

msgid "Radius"
msgstr "Ακτίνα"

msgid "Send to a specific location"
msgstr "Στείλτε σε συγκεκριμένη τοποθεσία"

#. machine-translated (2026-10), to be reviewed
msgid "Send to all applications"
msgstr "Αποστολή σε όλες τις εφαρμογές"

msgid "Send to all my users"
msgstr "Αποστολή σε όλους τους χρήστες"

msgid "Send to no specific locations"
msgstr "Αποστολή χωρίς συγκεκριμένες τοποθεσίες"

msgid "Send to specific topics"
msgstr "Αποστολή σε συγκεκριμένα topics"

#. machine-translated (2026-10), to be reviewed
msgid "Send to specific users"
msgstr "Αποστολή σε συγκεκριμένους χρήστες"

msgid "Sending date"
msgstr "Ημ/νία αποστολής"

msgid "The duration limit must be higher than the sent date"
msgstr "Το όριο διαρκείας, πρέπει να είναι μεταγενέστερο της ημ/νίας αποστολής"

#. machine-translated (2026-10), to be reviewed
msgid "Topics"
msgstr "Θέματα"

msgid "Users"
msgstr "Χρήστες"

#. machine-translated (2026-10), to be reviewed
msgid "You must choose a topic before sending your message."
msgstr "Πρέπει να επιλέξετε θέμα πριν στείλετε το μήνυμά σας."

#. machine-translated (2026-10), to be reviewed
msgid "You must choose at least one user before sending your message."
msgstr "Πρέπει να επιλέξετε τουλάχιστον έναν χρήστη πριν στείλετε το μήνυμά σας."

msgid "Your app must be published to send a push notification."
msgstr ""
"Η εφαρμογή σας θα πρέπει να έχει δημοσιευθεί για να στείλετε μήνυμα Push."

msgid "Your message has been saved successfully."
msgstr "Το μήνυμά σας αποθηκεύτηκε επιτυχώς."

msgid ""
"Your message has been saved successfully and will be sent at the entered date"
msgstr ""
"Το μήνυμά σας αποθηκεύτηκε επιτυχώς και θα αποσταλεί την ορισμένη ημ/νία"

msgid ""
"Your message has been saved successfully and will be sent in a few minutes"
msgstr "Το μήνυμά σας αποθηκεύτηκε επιτυχώς και θα αποσταλεί σε λίγα λεπτά"

msgid "and users entering the area"
msgstr "και χρήστες που εισέρχονται στην περιοχή"

msgid "for a limited period"
msgstr "για περιορισμένη περίοδο"

msgid "now"
msgstr "τώρα"

msgid "on a specific date"
msgstr "σε συγκεκριμένη ημ/νία"

