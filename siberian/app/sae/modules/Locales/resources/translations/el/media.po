msgid "+ Add a track"
msgstr "+ Προσθήκη τραγουδιού"

msgid "Add albums and tracks to the playlist:"
msgstr "Προσθήκη album και τραγουδιών στην playlist:"

msgid "Album"
msgstr "Album"

msgid "Albums"
msgstr "Albums"

msgid ""
"An error occurred while deleting you images gallery. Please try again later."
msgstr ""
"Υπήρξε σφάλμα κατά την διαγραφή της gallery φωτογραφιών σας. Παρακαλούμε "
"δοκιμάστε ξανά αργότερα."

msgid "An error occurred while deleting your album. Thanks for trying later."
msgstr ""
"Υπήρξε σφάλμα κατά την διαγραφή των albums σας. Παρακαλούμε δοκιμάστε ξανά "
"αργότερα."

msgid ""
"An error occurred while deleting your playlist. Thanks for trying later."
msgstr ""
"Υπήρξε σφάλμα κατά την διαγραφή της playlist σας. Παρακαλούμε δοκιμάστε ξανά "
"αργότερα."

msgid "An error occurred while deleting your track. Thanks for trying later."
msgstr ""
"Υπήρξε σφάλμα κατά την διαγραφή του τραγουδιού σας. Παρακαλούμε δοκιμάστε "
"ξανά αργότερα."

msgid "An error occurred while loading pictures. Please try later."
msgstr ""
"Υπήρξε σφάλμα κατά το ανέβασμα των εικόνων σας. Παρακαλούμε δοκιμάστε ξανά "
"αργότερα."

msgid "An error occurred while loading the media."
msgstr "Παρουσιάστηκε σφάλμα κατά τη φόρτωση αυτής της εκδήλωσης"

msgid "An error occurred while loading the radio."
msgstr "Παρουσιάστηκε σφάλμα κατά την προσθήκη της επιλογής"

msgid "An error occurred while loading videos. Please try later."
msgstr ""
"Υπήρξε σφάλμα κατά το ανέβασμα των videos σας. Παρακαλούμε δοκιμάστε ξανά "
"αργότερα."

#. machine-translated (2026-10), to be reviewed
msgid ""
"An error occurred while retrieving your page. Please check your page id."
msgstr "Παρουσιάστηκε σφάλμα κατά την ανάκτηση της σελίδας σας. Ελέγξτε το id της σελίδας σας."

msgid ""
"An error occurred while saving your images gallery. Please try again later."
msgstr ""
"Υπήρξε σφάλμα κατά την αποθήκευση της gallery φωτογραφιών σας. Παρακαλούμε "
"δοκιμάστε ξανά αργότερα."

msgid "An error occurred while saving your playlist. Thanks for trying later."
msgstr ""
"Υπήρξε σφάλμα κατά την αποθήκευση της playlist σας. Παρακαλούμε δοκιμάστε "
"ξανά αργότερα."

msgid ""
"An error occurred while saving your videos gallery. Please try again later."
msgstr ""
"Υπήρξε σφάλμα κατά την αποθήκευση της video gallery σας. Παρακαλούμε "
"δοκιμάστε ξανά αργότερα."

msgid "Are you sure you don't want to create an album for these tracks?"
msgstr ""
"Είστε σίγουροι ότι θέλετε να δημιουργήσετε ένα album για αυτά τα τραγούδια?"

msgid "Are you sure you don't want to create an album for this track?"
msgstr ""
"Είστε σίγουροι ότι θέλετε να δημιουργήσετε ένα album για αυτό το τραγούδι?"

msgid "Are you sure you want to delete this album?"
msgstr "Είστε σίγουροι ότι θέλετε να διαγράψετε αυτό το album?"

msgid "Are you sure you want to delete this album (this won't delete tracks)?"
msgstr ""
"Είστε σίγουροι ότι θέλετε να διαγράψετε αυτό το album? (Δεν θα διαγραφούν τα "
"τραγουδία που περιλαμβάνονται σε αυτό)"

msgid "Are you sure you want to delete this playlist?"
msgstr "Είστε σίγουροι ότι θέλετε να διαγράψετε αυτό το playlist?"

msgid "Are you sure you want to delete this track?"
msgstr "Είστε σίγουροι ότι θέλετε να διαγράψετε αυτό το τραγούδι?"

