# GMT 1793000000.0001
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "This version is already installed"
msgstr "Αυτή η έκδοση είναι ήδη εγκατεστημένη"

# GMT 1793000000.0002
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Would you like to reinstall it? Files are copied again and the module schema and data are synchronized again."
msgstr "Θέλετε να την εγκαταστήσετε ξανά; Τα αρχεία αντιγράφονται ξανά και το σχήμα και τα δεδομένα της ενότητας συγχρονίζονται ξανά."

# GMT 1793000000.0003
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Yes, reinstall"
msgstr "Ναι, επανεγκατάσταση"

# GMT 1793000000.0004
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "No, cancel"
msgstr "Όχι, ακύρωση"

# GMT 1793100000.0001
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The license saved for this module is expired or no longer valid. If you received a new key, enter it here, or keep the current one."
msgstr "Η άδεια που έχει αποθηκευτεί για αυτήν την ενότητα έχει λήξει ή δεν είναι πλέον έγκυρη. Εάν λάβατε νέο κλειδί, εισαγάγετέ το εδώ, ή κρατήστε το τρέχον."

# GMT 1793100000.0002
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Keep the current key"
msgstr "Διατήρηση του τρέχοντος κλειδιού"

