# GMT 1793100001.0030
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "This job has no command."
msgstr "Αυτή η εργασία δεν έχει εντολή."

# GMT 1793100001.0031
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The class %s does not exist, the module providing this job is probably disabled or removed."
msgstr "Η κλάση %s δεν υπάρχει, η ενότητα που παρέχει αυτήν την εργασία είναι πιθανώς απενεργοποιημένη ή αφαιρεμένη."

# GMT 1793100001.0032
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The class %s can not be loaded: %s"
msgstr "Η κλάση %s δεν μπορεί να φορτωθεί: %s"

# GMT 1793100001.0033
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s does not exist."
msgstr "Η μέθοδος %s δεν υπάρχει."

# GMT 1793100001.0034
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s is not public."
msgstr "Η μέθοδος %s δεν είναι δημόσια."

# GMT 1793100001.0035
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s is abstract."
msgstr "Η μέθοδος %s είναι αφηρημένη."

# GMT 1793100001.0036
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s requires %d arguments, a job is given %d."
msgstr "Η μέθοδος %s απαιτεί %d ορίσματα, η εργασία δίνει %d."

# GMT 1793100001.0037
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The class %s can not be instantiated, declare the method %s static."
msgstr "Η κλάση %s δεν μπορεί να δημιουργηθεί ως αντικείμενο, δηλώστε τη μέθοδο %s ως static."

# GMT 1793100001.0038
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s is not static and the constructor of %s requires arguments, declare the method static."
msgstr "Η μέθοδος %s δεν είναι static και ο constructor του %s απαιτεί ορίσματα, δηλώστε τη μέθοδο ως static."

# GMT 1793100001.0039
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The method %s is not static. PHP 8 can not call it statically, the scheduler runs it on a new instance instead; declare it static."
msgstr "Η μέθοδος %s δεν είναι static. Η PHP 8 δεν μπορεί να την καλέσει στατικά, ο προγραμματιστής την εκτελεί σε νέο αντικείμενο· δηλώστε την ως static."

# GMT 1793100001.0040
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "This job can run."
msgstr "Αυτή η εργασία μπορεί να εκτελεστεί."

# GMT 1793100001.0041
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Compatibility with PHP"
msgstr "Συμβατότητα με PHP"

# GMT 1793100001.0042
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Every job is checked against the PHP version that runs the scheduler, without running it."
msgstr "Κάθε εργασία ελέγχεται σε σχέση με την έκδοση PHP που εκτελεί τον προγραμματιστή, χωρίς να εκτελεστεί."

# GMT 1793100001.0043
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "PHP version"
msgstr "Έκδοση PHP"

# GMT 1793100001.0044
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Active jobs checked"
msgstr "Ενεργές εργασίες που ελέγχθηκαν"

# GMT 1793100001.0045
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "All the active jobs can be run by the scheduler."
msgstr "Όλες οι ενεργές εργασίες μπορούν να εκτελεστούν από τον προγραμματιστή."

# GMT 1793100001.0046
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "A job that can not run is skipped and reported, it never stops the other jobs."
msgstr "Μια εργασία που δεν μπορεί να εκτελεστεί παραλείπεται και αναφέρεται, δεν σταματά ποτέ τις άλλες εργασίες."

# GMT 1793100001.0047
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Job"
msgstr "Εργασία"

# GMT 1793100001.0048
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Problem"
msgstr "Πρόβλημα"

# GMT 1793100001.0049
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Last error"
msgstr "Τελευταίο σφάλμα"

# GMT 1793100001.0050
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Compatibility"
msgstr "Συμβατότητα"

# GMT 1793100001.0051
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Some cron jobs can not run with this PHP version:"
msgstr "Ορισμένες εργασίες cron δεν μπορούν να εκτελεστούν με αυτήν την έκδοση PHP:"

# GMT 1793100001.0052
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "see the details"
msgstr "δείτε τις λεπτομέρειες"

# GMT 1793100001.0060
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Modules in quarantine"
msgstr "Ενότητες σε καραντίνα"

# GMT 1793100001.0061
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "A module stopped the application with a fatal error, or is not compatible with this version of Siberian or PHP. It is disabled until it is rechecked, the rest of the application keeps working."
msgstr "Μια ενότητα σταμάτησε την εφαρμογή με κρίσιμο σφάλμα ή δεν είναι συμβατή με αυτήν την έκδοση του Siberian ή της PHP. Είναι απενεργοποιημένη μέχρι να ελεγχθεί ξανά, το υπόλοιπο της εφαρμογής συνεχίζει να λειτουργεί."

# GMT 1793100001.0062
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Needs a newer Siberian"
msgstr "Χρειάζεται νεότερο Siberian"

# GMT 1793100001.0063
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Failed the compatibility check"
msgstr "Απέτυχε στον έλεγχο συμβατότητας"

# GMT 1793100001.0064
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Fatal error"
msgstr "Κρίσιμο σφάλμα"

# GMT 1793100001.0065
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Updated since, recheck it to enable it again."
msgstr "Ενημερώθηκε έκτοτε, ελέγξτε την ξανά για να την ενεργοποιήσετε εκ νέου."

# GMT 1793100001.0066
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Recheck"
msgstr "Νέος έλεγχος"

# GMT 1793100001.0067
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Re-enable"
msgstr "Επανενεργοποίηση"

# GMT 1793100001.0068
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Enable this module anyway? If it breaks the application again it goes back to quarantine."
msgstr "Να ενεργοποιηθεί αυτή η ενότητα παρ' όλα αυτά; Εάν χαλάσει ξανά την εφαρμογή, θα επιστρέψει σε καραντίνα."

# GMT 1793100001.0069
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Recheck all"
msgstr "Νέος έλεγχος όλων"

# GMT 1793100001.0070
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Scan all modules"
msgstr "Σάρωση όλων των ενοτήτων"

# GMT 1793100001.0071
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "PHP or Siberian changed since the last compatibility scan of your modules."
msgstr "Η PHP ή το Siberian άλλαξε από την τελευταία σάρωση συμβατότητας των ενοτήτων σας."

# GMT 1793100001.0072
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Quarantine"
msgstr "Καραντίνα"

# GMT 1793100001.0073
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "Recheck done, %s released."
msgstr "Ο νέος έλεγχος ολοκληρώθηκε, %s αποδεσμεύτηκαν."

# GMT 1793100001.0074
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The module is enabled again."
msgstr "Η ενότητα ενεργοποιήθηκε ξανά."

# GMT 1793100001.0075
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The scan started, it can take a few minutes, reload this page to see the result."
msgstr "Η σάρωση ξεκίνησε, μπορεί να διαρκέσει λίγα λεπτά, φορτώστε ξανά αυτήν τη σελίδα για να δείτε το αποτέλεσμα."

# GMT 1793100001.0076
#. machine-translated (2026-10), to be reviewed
msgctxt "backoffice"
msgid "The scan could not be started, run \"php cli module:quarantine scan\" instead."
msgstr "Δεν ήταν δυνατή η έναρξη της σάρωσης, εκτελέστε αντ' αυτού την εντολή \"php cli module:quarantine scan\"."
