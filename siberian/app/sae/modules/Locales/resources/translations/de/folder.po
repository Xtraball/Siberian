msgid "Click on a page to add it to the folder"
msgstr "Klicken Sie auf eine Seite, um sie dem Ordner hinzuzufügen"

msgid ""
"Click on a page to add it to the folder <span id='folder_name' "
"class='folder_name'>%s</span>"
msgstr "Klicken Sie auf eine Seite, um sie dem Ordner <span id='folder_name' class='folder_name'>%s</span> hinzuzufügen"

msgid "Close mobile display"
msgstr "Mobile Ansicht schließen"

msgid "Delete this folder and all its subfolders?"
msgstr "Löschen Sie diesen Ordner und alle seine Unterordner?"

msgid "Edit folder"
msgstr "Ordner bearbeiten"

msgid "Enable search in folders"
msgstr "Suche in Ordnern aktivieren"

msgid "Folder title is required"
msgstr "Titel Ordner ist erforderlich"

