<div id="services-details"
     ng-show="svc.open">
    <div class="modal-content">
        <div class="modal-header">
            <h4 class="modal-title"><?php echo p__('backoffice', 'Services') ?></h4>
        </div>
        <div class="modal-body">
            <div class="webspace-row">
                <i class="dot svc-{{ cronState() }}"></i>
                <div class="webspace-row-text">
                    <b><?php echo __("Cron scheduler") ?></b>
                    <small ng-if="cronState() === 'off'"><?php echo __("Disabled") ?>,
                        <a href="<?php echo $this->getUrl("backoffice/advanced_cron") ?>"><?php echo __("see Settings > Advanced > Configuration > Cron to edit options.") ?></a>
                    </small>
                    <small ng-if="cronState() === 'down'"><?php echo __("Not running") ?>.
                        <a href="javascript:void(0);"
                           ng-click="svc.open = false; showCronModal();"><?php echo __("How to install the cron scheduler ?") ?></a>
                    </small>
                    <small ng-if="cronState() === 'ok' || cronState() === 'warn'">
                        <?php echo p__('backoffice', 'Running') ?>, <?php echo __("Last run") ?> :
                        <strong>{{ services.cron_last_run || "<?php echo __("never") ?>" }}</strong>
                    </small>
                    <small ng-if="services.cron_locks > 0">
                        {{ services.cron_locks }} <?php echo p__('backoffice', 'lock files') ?>
                    </small>
                    <small ng-if="services.cron_compat.problems > 0">
                        <i class="fa fa-exclamation-triangle"></i>
                        <?php echo p__('backoffice', 'Some cron jobs can not run with this PHP version:') ?>
                        <span ng-repeat="item in services.cron_compat.items | limitTo:3">
                            <strong>{{ item.name }}</strong><span ng-if="!$last">, </span>
                        </span>
                        <span ng-if="services.cron_compat.items.length > 3">&hellip;</span>
                        <a href="<?php echo $this->getUrl("backoffice/advanced_cron") ?>"><?php echo p__('backoffice', 'see the details') ?></a>
                    </small>
                </div>
                <button ng-if="services.cron_locks > 0"
                        class="btn btn-xs btn-primary"
                        ng-click="clear('locks', '<?php echo addcslashes(__("You are about to clean all the cron lock files !\nAre you sure ?"), "'"); ?>');"><?php echo __("Remove locks") ?></button>
                <span ng-if="!(services.cron_locks > 0)"></span>
            </div>
            <div class="webspace-row" ng-if="svc.cronActive">
                <i class="dot svc-{{ services.cron_error.full ? 'warn' : 'ok' }}"></i>
                <div class="webspace-row-text">
                    <b><?php echo p__('backoffice', 'Cron errors') ?></b>
                    <small ng-if="!services.cron_error.full"><?php echo p__('backoffice', 'No error recorded.') ?></small>
                    <small ng-if="services.cron_error.full">
                        <?php echo p__('backoffice', 'Last error') ?> {{ services.cron_error.date }}. <?php echo p__('backoffice', 'The cron itself keeps its own status above.') ?>
                    </small>
                    <small ng-if="services.cron_error.full" class="svc-error-line">
                        {{ services.cron_error.short }}
                        <a href="javascript:void(0);"
                           ng-click="cron_error_show = !cron_error_show;"><span ng-hide="cron_error_show"><?php echo __("Show more") ?></span><span ng-show="cron_error_show"><?php echo __("Hide") ?></span></a>
                    </small>
                    <small class="svc-error-full"
                           ng-if="services.cron_error.full && cron_error_show"
                           ng-bind-html="services.cron_error.full"></small>
                </div>
                <button class="btn btn-xs btn-primary"
                        ng-if="services.cron_error.full"
                        ng-click="clear('cron_error');"><?php echo __("Clear") ?></button>
                <span ng-if="!services.cron_error.full"></span>
            </div>
            <div class="webspace-row">
                <i class="dot svc-ok"></i>
                <div class="webspace-row-text">
                    <b>PHP</b>
                    <small><?php echo __("PHP version") ?> <?php echo explode("-", phpversion())[0] ?></small>
                </div>
                <span></span>
            </div>
            <div class="webspace-row">
                <i class="dot svc-{{ extensions.php_sqlite3 || extensions.bin_sqlite3 ? 'ok' : 'down' }}"></i>
                <div class="webspace-row-text">
                    <b>SQLite3</b>
                    <small ng-if="extensions.php_sqlite3"><?php echo p__('backoffice', 'PHP extension available') ?></small>
                    <small ng-if="!extensions.php_sqlite3 && extensions.bin_sqlite3"><?php echo __("Bin SQLite3:") ?> <?php echo p__('backoffice', 'available') ?></small>
                    <small ng-if="!extensions.php_sqlite3 && !extensions.bin_sqlite3"><?php echo __("Not found") ?></small>
                </div>
                <i class="fa fa-check svc-check" ng-if="extensions.php_sqlite3 || extensions.bin_sqlite3"></i>
                <span ng-if="!extensions.php_sqlite3 && !extensions.bin_sqlite3"></span>
            </div>
            <div class="webspace-row">
                <i class="dot svc-{{ binaryCount() === 4 ? 'ok' : 'info' }}"></i>
                <div class="webspace-row-text">
                    <b><?php echo __("Optional binaries") ?></b>
                    <div class="svc-pills">
                        <span class="svc-pill"><?php echo __("OptiPNG:") ?> <i class="fa fa-check" ng-if="libraries.optipng"></i><em ng-if="!libraries.optipng"><?php echo __("Not found") ?></em></span>
                        <span class="svc-pill"><?php echo __("JpegOptim:") ?> <i class="fa fa-check" ng-if="libraries.jpegoptim"></i><em ng-if="!libraries.jpegoptim"><?php echo __("Not found") ?></em></span>
                        <span class="svc-pill"><?php echo __("PNGQuant:") ?> <i class="fa fa-check" ng-if="libraries.pngquant"></i><em ng-if="!libraries.pngquant"><?php echo __("Not found") ?></em></span>
                        <span class="svc-pill"><?php echo __("ClamAV:") ?> <i class="fa fa-check" ng-if="libraries.clamav"></i><em ng-if="!libraries.clamav"><?php echo __("Not found") ?></em></span>
                    </div>
                </div>
                <span></span>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-default"
                    ng-click="svc.open = false;"><?php echo __("Close"); ?></button>
        </div>
    </div>
</div>

