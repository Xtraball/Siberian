<?php
$owner = exec("stat -c \"%U\" '" . APPLICATION_PATH . "/../index.php'", $output, $exitCode);
if ($exitCode === 1) {
    $owner = exec("ls -al  '" . APPLICATION_PATH . "/../index.php' | awk '{print $3}'", $output, $exitCode);
}

$integrityLabels = [
    'core' => p__('backoffice', 'Core'),
    'apps' => p__('backoffice', 'App sources'),
    'modified' => p__('backoffice', 'Modified'),
    'missing' => p__('backoffice', 'Missing'),
    'unreadable' => p__('backoffice', 'Unreadable'),
];
?>

