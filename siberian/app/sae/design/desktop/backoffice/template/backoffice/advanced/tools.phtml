<form ng-submit="test_integrity()"
      ng-init="integrity_labels = <?php echo htmlspecialchars(json_encode($integrityLabels), ENT_QUOTES); ?>"
      class="form-horizontal">
    <sb-section title="'<?php echo addcslashes(__("Integrity check"), "'"); ?>'">

        <div class="form-group">
            <div class="col-md-12">
                <div class="alert alert-info">
                    <i class="fa fa-info-circle"></i>
                    <?php echo __("This test is for development & support usage, this only highlights potential missing and/or modified files, results need to be interpreted.") ?>
                    <?php echo p__('backoffice', 'Module installations and generated apps also write in the app sources, differences there are not necessarily a problem.') ?>
                </div>
            </div>
            <div class="col-md-12">
                <button type="submit"
                        ng-disabled="integrity.running"
                        class="btn btn-primary right">
                    <i class="fa fa-play"></i> <?php echo __("Run test"); ?></button>
                <label class="integrity-scope">
                    <input type="checkbox"
                           ng-model="integrity.scope"
                           ng-true-value="'core'"
                           ng-false-value="'all'"
                           ng-disabled="integrity.running" />
                    <?php echo p__('backoffice', 'Core files only, skip the app sources (faster)'); ?>
                </label>
                <sb-loader is_visible="integrity.running"
                           type="'inner_content'"
                           size="'small'"
                           animation="'no'"
                           class="form_loader"></sb-loader>
                <div class="clear"></div>
            </div>
        </div>

        <div class="form-group"
             ng-show="integrity.running || integrity.done">
            <div class="col-md-12">
                <p>
                    <?php echo p__('backoffice', 'Files checked'); ?>:
                    <strong>{{ integrity.checked }} / {{ integrity.total }}</strong>
                </p>
                <div class="progress"
                     ng-show="integrity.running">
                    <div class="progress-bar"
                         ng-style="{width: (integrity.total ? (integrity.checked * 100 / integrity.total) : 0) + '%'}"></div>
                </div>
            </div>

            <div class="col-md-12"
                 ng-show="integrity.done && integrity.rows.length">
                <table class="table table-condensed integrity-summary">
                    <thead>
                    <tr>
                        <th><?php echo p__('backoffice', 'Area'); ?></th>
                        <th>{{ integrity_labels.modified }}</th>
                        <th>{{ integrity_labels.missing }}</th>
                        <th>{{ integrity_labels.unreadable }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr ng-repeat="area in ['core', 'apps']"
                        ng-show="area === 'core' || integrity.scope !== 'core'">
                        <td>{{ integrity_labels[area] }}</td>
                        <td>{{ integrityCount(area, 'modified') }}</td>
                        <td>{{ integrityCount(area, 'missing') }}</td>
                        <td>{{ integrityCount(area, 'unreadable') }}</td>
                    </tr>
                    </tbody>
                </table>

                <div class="integrity-list">
                    <table class="table table-condensed table-striped">
                        <thead>
                        <tr>
                            <th><?php echo p__('backoffice', 'File'); ?></th>
                            <th><?php echo p__('backoffice', 'Status'); ?></th>
                            <th><?php echo p__('backoffice', 'Area'); ?></th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr ng-repeat="row in integrity.rows">
                            <td class="integrity-file">{{ row.file }}</td>
                            <td>{{ integrity_labels[row.status] }}</td>
                            <td>{{ integrity_labels[row.area] }}</td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </sb-section>
</form>

