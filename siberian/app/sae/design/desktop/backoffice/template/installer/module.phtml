<sb-section title="'<?php echo __title("Upload your modules"); ?>'"
            class="upload_area">
    <br/>
    <div class="relative">
        <div class="col-md-7">
            <div class="drop_a_file">
                <label id="module_zone_label"><?php echo p__('backoffice', 'Send your module'); ?></label>
                <input id="file_uploader"
                       class="module-file-input"
                       type="file"
                       tabindex="-1"
                       aria-hidden="true"
                       nv-file-select=""
                       uploader="uploader"/>
                <div id="module_zone"
                     class="well drop-zone module-zone"
                     role="button"
                     tabindex="0"
                     aria-labelledby="module_zone_label module_zone_status"
                     ng-attr-aria-busy="{{ zoneBusy() }}"
                     ng-class="'is-' + zoneState()"
                     ng-click="openFilePicker()"
                     ng-keydown="zoneKeydown($event)"
                     nv-file-drop=""
                     nv-file-over=""
                     uploader="uploader">
                    <i class="fa module-zone-icon" ng-class="zoneIcon()"></i>
                    <div id="module_zone_status" class="module-zone-text" aria-live="polite">
                        <span ng-show="zoneState() === 'idle'"><?php echo p__('backoffice', 'Click to choose your module, or drop it here'); ?></span>
                        <span ng-show="zoneState() === 'sending'"><?php echo p__('backoffice', 'Sending your module, please do not close the page.'); ?> {{ uploader.progress }}%</span>
                        <span ng-show="zoneState() === 'checking'"><?php echo p__('backoffice', 'Checking the module licence...'); ?></span>
                        <span ng-show="zoneState() === 'done'"><?php echo p__('backoffice', 'Module sent, review the package details below.'); ?></span>
                        <span ng-show="zoneState() === 'license'"><?php echo p__('backoffice', 'A licence key is needed to install this module. Click to choose another file.'); ?></span>
                        <span ng-show="zoneState() === 'error'"><?php echo p__('backoffice', 'The module could not be sent. Click to choose another file.'); ?></span>
                    </div>
                    <div class="module-zone-file" ng-show="zone.file">{{ zone.file }}</div>
                    <div class="progress module-zone-progress" ng-show="zoneState() === 'sending'">
                        <div class="progress-bar progress-bar-striped"
                             role="progressbar"
                             ng-style="{ 'width': uploader.progress + '%' }"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-1">
            <div class="drop_a_file">
                <label><?php echo __("OR"); ?></label>
            </div>
        </div>

        <div class="col-md-4">
            <label><?php echo p__('backoffice', 'Siberian updates'); ?></label>
            <div ng-show="check_for_updates.check">
                <button type="button"
                        id="check_for_updates"
                        class="btn btn-primary btn-lg check-updates-button"
                        ng-click="downloadUpdate()"
                        ng-disabled="check_for_updates.loader_is_visible || zoneBusy()">
                    <i class="fa fa-refresh"
                       ng-class="{'fa-spin': check_for_updates.loader_is_visible}"></i>
                    <span ng-show="!check_for_updates.loader_is_visible"><?php echo __("Check for updates"); ?></span>
                    <span ng-show="check_for_updates.loader_is_visible"><?php echo p__('backoffice', 'Checking for updates...'); ?></span>
                </button>
            </div>
            <p class="check-updates-result"
               role="status"
               aria-live="polite"
               ng-show="check_for_updates.result && !check_for_updates.loader_is_visible"
               ng-class="{'text-danger': check_for_updates.result === 'error', 'text-success': check_for_updates.result !== 'error'}">
                <i class="fa"
                   ng-class="check_for_updates.result === 'error' ? 'fa-exclamation-triangle' : 'fa-check'"></i>
                <span ng-show="check_for_updates.result === 'downloaded'"><?php echo p__('backoffice', 'Update downloaded, review the package details below.'); ?></span>
                <span ng-show="check_for_updates.result !== 'downloaded'">{{ check_for_updates.message }}</span>
            </p>
        </div>

        <div class="clear"></div>

        <div class="update-mask toggle"
             ng-show="check_for_updates.loader_is_visible">
            <sb-loader is_visible="check_for_updates.loader_is_visible"
                       type="'inner_content'"
                       size="'big'"
                       animation="'toggle'"></sb-loader>
            <h3 class="text-center" ng-show="!module_updates.busy_code"><?php echo __("We are checking for updates. Please, do not refresh the page."); ?></h3>
            <h3 class="text-center" ng-show="module_updates.busy_code"><?php echo p__('backoffice', 'Downloading the update. Please, do not refresh the page.'); ?></h3>
        </div>
    </div>
</sb-section>

<sb-section title="'<?php echo __title("Module updates"); ?>'">
    <div class="col-md-12">
        <p>
            <button class="btn btn-primary"
                    ng-click="checkModuleUpdates(true)"
                    ng-disabled="module_updates.loading">
                <i class="fa fa-refresh" ng-class="{'fa-spin': module_updates.loading}"></i> <?php echo p__('backoffice', 'Check now'); ?>
            </button>
            <span ng-show="module_updates.fetched_at">
                &nbsp;<?php echo __("Last check"); ?>: {{ module_updates.fetched_at * 1000 | date:'medium' }}
            </span>
        </p>
        <p class="alert alert-warning" ng-show="module_updates.stale">
            <?php echo __("The update service is not reachable, this list may be out of date."); ?>
        </p>
        <p class="alert alert-danger" ng-show="module_updates.error">{{ module_updates.error }}</p>
        <table class="table">
            <thead>
            <tr>
                <th width="30%"><?php echo __("Module") ?></th>
                <th width="15%"><?php echo __("Installed") ?></th>
                <th width="15%"><?php echo __("Available") ?></th>
                <th><?php echo __("Notes") ?></th>
                <th><?php echo __("Actions") ?></th>
            </tr>
            </thead>
            <tbody>
            <tr ng-repeat="update in module_updates.updates">
                <td><strong>{{ update.name }}</strong>
                    <br ng-show="update.license_missing" />
                    <small class="text-warning" ng-show="update.license_missing"><?php echo __("Licence key needed, you will be asked for it."); ?></small>
                </td>
                <td>{{ update.installed }}</td>
                <td>{{ update.available }}</td>
                <td>
                    <a ng-show="update.release_notes_url" ng-href="{{ update.release_notes_url }}" target="_blank" rel="noopener"><?php echo __("Release notes"); ?></a>
                    <span ng-show="!update.compatible" class="text-danger">
                        <?php echo __("Requires Siberian"); ?> {{ update.min_siberian }}
                    </span>
                </td>
                <td nowrap>
                    <button type="button"
                            class="btn btn-primary btn-xs"
                            ng-click="updateModule(update)"
                            ng-disabled="!update.compatible || module_updates.busy_code">
                        <i class="fa" ng-class="module_updates.busy_code === update.code ? 'fa-spinner fa-spin' : 'fa-download'"></i> <?php echo __("Update"); ?>
                    </button>
                </td>
            </tr>
            <tr ng-show="module_updates.loading">
                <td colspan="5"><i class="fa fa-spinner fa-spin"></i> <?php echo p__('backoffice', 'Checking for module updates...'); ?></td>
            </tr>
            <tr ng-show="!module_updates.updates.length && !module_updates.loading && !module_updates.error">
                <td colspan="5"><?php echo __("All your modules are up to date."); ?></td>
            </tr>
            </tbody>
        </table>
    </div>
    <div class="clear"></div>
</sb-section>

<sb-section title="'<?php echo __title("Module to upload"); ?>'">
    <table class="table">
        <thead>
        <tr>
            <th width="50%"><?php echo __("Name") ?></th>
            <th ng-show="uploader.isHTML5"><?php echo __("Size") ?></th>
            <th ng-show="uploader.isHTML5"><?php echo __("Progress") ?></th>
            <th><?php echo __("Status") ?></th>
            <th><?php echo __("Actions") ?></th>
        </tr>
        </thead>
        <tbody>
        <tr class="slide-down"
            ng-repeat="item in uploader.queue"
            ng-show="uploader.queue.length">
            <td><strong>{{ item.file.name }}</strong></td>
            <td ng-show="uploader.isHTML5"
                nowrap>{{ item.file.size/1024/1024|number:2 }} MB</td>
            <td ng-show="uploader.isHTML5">
                <div class="progress">
                    <div class="progress-bar progress-bar-striped"
                         role="progressbar"
                         ng-style="{ 'width': item.progress + '%' }"></div>
                </div>
            </td>
            <td class="text-center">
                <span ng-show="item.isSuccess"><i class="fa fa-check"></i></span>
                <span ng-show="item.isCancel"><i class="fa fa-ban"></i></span>
                <span ng-show="item.isError"><i class="fa fa-remove"></i></span>
            </td>
            <td nowrap>
                <button type="button"
                        class="btn btn-primary btn-xs"
                        ng-click="item.upload()"
                        ng-disabled="item.isReady || item.isUploading || item.isSuccess">
                    <span class="fa fa-upload"></span>
                </button>
                <button type="button"
                        class="btn btn-danger btn-xs"
                        ng-click="item.remove()"
                        ng-disabled="item.isReady || item.isUploading || item.isSuccess">
                    <span class="fa fa-remove"></span>
                </button>
            </td>
        </tr>
        <tr class="slide-top" ng-show="!uploader.queue.length">
            <td colspan="5">
                <?php echo __("No modules uploaded yet"); ?>
            </td>
        </tr>
        </tbody>
    </table>

</sb-section>

