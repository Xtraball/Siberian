{% extends 'base.html.twig' %}

{% block title %}Siberian Next - Requirements!{% endblock %}

{% block body %}
    <div class="block-center w-60">
        <h1>Siberian Next - Requirements!</h1>
        <p>This is a demo of Siberian Next, a modern Symfony application.</p>
        <p>It is a work in progress, and is not yet ready for production.</p>
        <p>If you see this page, it means that your server meet the requirements.</p>
        <p>It requires the following:</p>
        <ul>
            <li>PHP Version required: 8.2, your version is {{ php_version }}</li>

            {% for admin in admins %}
                <li>Admin: {{ admin.email }}</li>
            {% endfor %}

            {{ dump(admins) }}

            {% for customer in customers %}
                <li>Customer: {{ customer.email }}</li>
            {% endfor %}

            {{ dump(customers) }}
        </ul>
    </div>
{% endblock %}
