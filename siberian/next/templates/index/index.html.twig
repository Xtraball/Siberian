{% extends 'base.html.twig' %}

{% block title %}Hello IndexController!{% endblock %}

{% block body %}
<div class="example-wrapper">
    <twig:Alert message="Or use the fun HTML syntax!" />
    <twig:Button action="Click me!" />

    <h1>Hello {{ controller_name }}! ✅</h1>

    <a data-turbo-frame="the_frame_id" href="{{ path('app_turbo') }}">Turbo</a>

    <turbo-frame id="the_frame_id" src="{{ path('app_turbo') }}">
        A placeholder.
    </turbo-frame>

</div>
{% endblock %}
