# cp .env.example .env, then set the two passwords (the installer asks for the same database values:
# host db, database/user below, and the MARIADB_PASSWORD).
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=
MARIADB_DATABASE=siberian
MARIADB_USER=siberian

# PHP minor served by the app image (8.2 to 8.5, the range of composer.json)
PHP_VERSION=8.5
# port of the web container on the host
SIBERIAN_PORT=8080

# use published images instead of building locally
#SIBERIAN_APP_IMAGE=ghcr.io/xtraball/siberian-app:php8.5
#SIBERIAN_WEB_IMAGE=ghcr.io/xtraball/siberian-web:latest
